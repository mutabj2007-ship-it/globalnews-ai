# ---------------------------------------------------------------------------
# GlobalNews AI - Backend Environment Variables (example)
# Copy this file to `.env` in the same directory and fill in real values.
# Never commit `.env` — only this `.env.example` template belongs in git.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# CORS - the frontend origin allowed to call this API in local dev
FRONTEND_ORIGIN=http://localhost:3000

# GNews API key (https://gnews.io) - used by GNewsProvider.
# If this is left unset, the backend automatically runs the news module
# in mock mode (MockNewsProvider) instead. Never commit a real key.
GNEWS_API_KEY=replace_with_your_gnews_key

# OpenAI API key - used by OpenAiAnalysisProvider (backend-only; never
# exposed to the frontend). If this is left unset, the analysis module
# automatically runs in mock mode (MockAnalysisProvider) instead and the
# frontend clearly labels it "DEMO AI ANALYSIS". Never commit a real key.
OPENAI_API_KEY=replace_with_your_openai_key

# Model used for analysis requests. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

# Analysis cost/safety controls (all optional; sane defaults apply if unset)
# Maximum number of articles ever sent to the AI provider for one request.
ANALYSIS_MAX_ARTICLES=8
# Each article's title+summary is truncated to this many characters.
ANALYSIS_MAX_ARTICLE_CHARS=1200
# AI provider call timeout, in milliseconds.
ANALYSIS_TIMEOUT_MS=20000
# How long a successful analysis is cached in memory, in seconds. 0 disables caching.
ANALYSIS_CACHE_TTL_SECONDS=300

# Country-news endpoint (Sprint 5.2, used by /map) cache duration, in seconds.
COUNTRY_NEWS_CACHE_TTL_SECONDS=300
