# ---------------------------------------------------------------------------
# GlobalNews AI - Backend Environment Variables (example)
# Copy this file to `.env` in the same directory and fill in real values.
# Never commit `.env` — only this `.env.example` template belongs in git.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# CORS - the frontend origin allowed to call this API in local dev
FRONTEND_ORIGIN=http://localhost:3000

# GNews API key (https://gnews.io) - used by GNewsProvider.
# If this is left unset, the backend automatically runs the news module
# in mock mode (MockNewsProvider) instead. Never commit a real key.
GNEWS_API_KEY=replace_with_your_gnews_key

# OpenAI API key - used by OpenAiAnalysisProvider (backend-only; never
# exposed to the frontend). If this is left unset, the analysis module
# automatically runs in mock mode (MockAnalysisProvider) instead and the
# frontend clearly labels it "DEMO AI ANALYSIS". Never commit a real key.
OPENAI_API_KEY=replace_with_your_openai_key

# Model used for analysis requests. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

# Analysis cost/safety controls (all optional; sane defaults apply if unset)
# Maximum number of articles ever sent to the AI provider for one request.
ANALYSIS_MAX_ARTICLES=8
# Each article's title+summary is truncated to this many characters.
ANALYSIS_MAX_ARTICLE_CHARS=1200
# AI provider call timeout, in milliseconds.
ANALYSIS_TIMEOUT_MS=20000
# How long a successful analysis is cached in memory, in seconds. 0 disables caching.
ANALYSIS_CACHE_TTL_SECONDS=300

# Country-news endpoint (Sprint 5.2, used by /map) cache duration, in seconds.
COUNTRY_NEWS_CACHE_TTL_SECONDS=300
# Feed status shown on the World Map for GNews-sourced coverage.
# GNEWS_FEED_TIER accepts only "delayed" or "live" - anything else
# safely defaults to "delayed".
GNEWS_FEED_TIER=delayed
GNEWS_PROVIDER_DISPLAY_NAME=GNews Free

# ---------------------------------------------------------------------------
# Milestone 30 - AI execution safety and retry configuration
# ---------------------------------------------------------------------------

# Controls whether the analysis system runs in development or production mode.
# In development mode, mock AI analysis is allowed when no OpenAI key exists.
# In production mode, the backend fails closed if a valid OpenAI API key is missing.
#
# IMPORTANT:
# NODE_ENV=production always forces production AI mode even if
# AI_EXECUTION_MODE is omitted or set to development.
AI_EXECUTION_MODE=development

# Number of retry attempts after the initial OpenAI request fails due to
# a transient error such as HTTP 429, HTTP 5xx, or a network failure.
# 0 disables retries.
ANALYSIS_RETRY_ATTEMPTS=2

# Base delay in milliseconds used for exponential retry backoff.
ANALYSIS_RETRY_BASE_DELAY_MS=300

# ---------------------------------------------------------------------------
# Milestone #57 -- Optional Accounts (Google OAuth/OIDC)
# ---------------------------------------------------------------------------

# Google OAuth 2.0 / OIDC client credentials, used ONLY by the optional
# sign-in flow (GET /auth/google, GET /auth/google/callback). Accounts
# are entirely optional -- every existing browse/search/map/analysis
# capability works with these values absent. They are required only for
# a real user to complete Sign In successfully.
#
# Register an OAuth 2.0 Client ID (Web application type) in Google Cloud
# Console, with an authorized redirect URI of:
#   http://localhost:4000/auth/google/callback   (development)
#   https://<your-production-backend-host>/auth/google/callback
#
# Never commit real values -- the examples below are placeholders only.
OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=change_me

# Milestone #57 security correction -- HMAC-SHA256 secret used to
# authenticate the ephemeral OAuth flow-state cookie (gna_oauth_flow)
# before its state/codeVerifier/nonce fields are trusted during the
# callback. Deliberately SEPARATE from OAUTH_CLIENT_SECRET -- that
# value is Google's own credential; this one only ever needs to
# authenticate a value this backend generated for itself minutes
# earlier. Never commit a real value -- generate a long random string
# for each environment (e.g. openssl rand -base64 32).
OAUTH_FLOW_SECRET=change_me

# ---------------------------------------------------------------------------
# SUPPORT AI — the GlobalNews AI Support Agent (SUPPORT-AI-1)
# ---------------------------------------------------------------------------
#
# The agent writes an immediate first response into every new support ticket.
# THAT PART NEEDS NO CONFIGURATION AND NO PROVIDER: it is deterministic text
# chosen by category, it is written inside the same transaction as the ticket,
# and it happens whether or not anything below is set.
#
# These settings govern ONLY the optional follow-up step, in which a NEWS
# QUESTION -- and no other category -- is passed to the EXISTING analysis
# pipeline for an evidence-grounded answer. There is no second AI pipeline and
# no OpenAI client in the support module; see SUPPORT_AI_ENABLED below.

# Fail-closed. The agent attempts an analysis ONLY when this is exactly "true".
# Anything else -- unset, empty, "TRUE", "1", "yes" -- means no provider call
# is made and the ticket receives the honest stored fallback instead. Turning
# this off is the rollback for the whole analysis step and needs no deploy.
SUPPORT_AI_ENABLED=false

# How long a requester waits for the analysis step before the agent gives up
# and stores the fallback. Bounds the WAIT, not the provider call: the
# analysis pipeline takes no abort signal, so a timed-out request keeps
# running and keeps its concurrency slot until it settles.
SUPPORT_AI_TIMEOUT_MS=20000

# The most support-initiated analyses that may be in flight across this
# process at once. Past it the agent stores the fallback rather than queueing:
# a queue turns a burst into a longer burst and hides the cost.
SUPPORT_AI_MAX_CONCURRENT=2

# A per-ACCOUNT allowance for support-initiated analyses, as a limit and a
# window in milliseconds.
#
# THIS IS A SECOND BUDGET, NOT THE ANALYSIS ROUTE'S. POST /analysis/news is
# protected by AnalysisRateLimitGuard, which is an HTTP guard and cannot see a
# direct service call, so a user can spend both. Keep this small for exactly
# that reason. In-process, so two backend instances carry two allowances.
SUPPORT_AI_PER_USER_LIMIT=5
SUPPORT_AI_PER_USER_WINDOW=900000

# Global Reach remains inactive during convergence.
GLOBAL_REACH_ACQUISITION_ACTIVE=false
GLOBAL_REACH_SOURCE_ALLOWLIST=
