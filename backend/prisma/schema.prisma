generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id           String   @id
  title        String
  summary      String
  url          String   @unique
  imageUrl     String?
  sourceId     String
  sourceName   String
  sourcesCount Int      @default(1)
  category     String
  publishedAt  DateTime
  fetchedAt    DateTime @default(now())

  /// R4 GDELT — what KIND of time `publishedAt` is: 'publisher' (the outlet
  /// asserted it) or 'observed' (an aggregator recorded seeing the article
  /// then, an UPPER BOUND on publication). Defaults to 'publisher', which is
  /// a true statement about every row written before this column existed —
  /// only GNews wrote them, and GNews reports the outlet's own time.
  /// Validated on read rather than by a database enum; an unrecognized value
  /// is treated as UNPROVEN, never silently as 'publisher'.
  publishedAtBasis String @default("publisher")

  countryCode String?
  countryName String?

  relevanceScore  Int?
  confidenceScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countries ArticleCountry[]

  @@index([publishedAt])
  @@index([sourceId])
  @@index([category])
  @@index([countryCode])
}

model ArticleCountry {
  id             String  @id @default(cuid())
  articleId      String
  countryCode    String
  countryName    String
  relevanceScore Int
  isRelevant     Boolean @default(false)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, countryCode])
  @@index([countryCode])
  @@index([relevanceScore])
}

/// Milestone F1.a — administrative authorization.
///
/// ANALYST is this schema's name for the approved design's READ-ONLY
/// role; the design's own actor-type vocabulary already uses ANALYST.
///
/// There is deliberately no NONE member. "Not an administrator" is
/// represented by User.adminRole being NULL, so no value of this enum
/// can ever be mistaken for an absence of privilege.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  ANALYST
}

// Milestone #57 — Optional Accounts & User Continuity.
//
// Provider-neutral identity: User carries no provider-specific column
// at all. UserIdentity is the sole place a (provider, providerAccountId)
// pair lives, so adding a second OAuth provider later — or linking a
// second identity to an existing User — needs zero schema change here.
//
// Session stores only a SHA-256 hash of the raw session token (never
// the raw value itself) — see AuthService/SessionService. A database
// compromise alone can never be used to impersonate a session.
//
// SearchHistoryEntry deliberately stores only what's needed to let a
// signed-in user revisit/re-run a previous question: the query text,
// an optional countryCode, and a timestamp. Never the AI response,
// prompt contents, evidence snapshot, article bodies, raw provider
// output, or an articleId (a story-anchor is far more likely to be
// stale/unresolvable by the time a user revisits history than a plain
// country-level re-run, so it was deliberately excluded — see M57
// architecture decision).
//
// All three new models cascade-delete from User (onDelete: Cascade),
// so a single DELETE /users/me removes every account-owned row across
// all three tables in one operation — no orphaned data by construction.
model User {
  id          String   @id @default(uuid())
  email       String
  displayName String?
  createdAt   DateTime @default(now())

  /// Milestone F1.a — NULL means "not an administrator", and NULL is
  /// the only value any pre-existing row can hold: the column is
  /// nullable with NO default, and F1.a ships no code path that writes
  /// it. AuthService.findOrCreateUser() does not set it, so a new
  /// Google sign-in produces a non-administrator by construction
  /// rather than by policy. Administrator status is data, never a
  /// code constant and never configuration.
  adminRole AdminRole?

  askThreads        AskThread[]
  storedAskResults  StoredResult[]
  computeOperations ComputeOperation[]
  askBookmarks      AskBookmark[]

  identities UserIdentity[]
  sessions   Session[]
  history    SearchHistoryEntry[]

  /// Support loop S1 — a fourth account-owned relation, cascading like
  /// the three above, so DELETE /users/me still removes every row this
  /// account owns in one database operation and UsersService needs no
  /// change. See the SupportTicket model for the ownership rules.
  supportTickets SupportTicket[]

  /// R1/T2 — the previous MEANINGFUL return-surface visit.
  ///
  /// NOT last login: a long-lived session never re-logs in, so login is
  /// too coarse to answer "what is new since you were last here".
  /// NOT every request: that is a write amplifier, not a visit.
  /// NOT Session.createdAt: sessions are DELETED on sign-out and on
  /// expiry validation, so prior sessions are routinely gone and cannot
  /// be relied on as history.
  ///
  /// NULL means "never observed" and is the only value any pre-existing
  /// row can hold — the column is nullable with NO default. NULL is
  /// reported as "make no return claim". It is NEVER "everything is new".
  ///
  /// This is one half of a comparison. The other half is R0's
  /// NewsArticle.firstSeenAt, which is read from the immutable
  /// Article.fetchedAt column. This value is NEVER derived from
  /// publishedAt (mutable, provider-reported) and never from now().
  ///
  /// RETENTION: lives and dies with the User row. DELETE /users/me
  /// removes it with the row; no separate deletion path is needed.
  lastSeenAt DateTime?

  /// MY INTELLIGENCE R1 — the STABLE previous-visit boundary.
  ///
  /// lastSeenAt stays the ONLY activity clock. This column is a snapshot of
  /// it, taken exactly once per new visit: when a request arrives ≥30 min
  /// after lastSeenAt, the old lastSeenAt is copied here by compare-and-set
  /// (so two tabs opening together rotate it exactly once). Inside a visit it
  /// never changes, which is what lets "new since your last visit" stay the
  /// same on reload. NULL means no previous visit is known — "make no return
  /// claim", never "everything is new". No default: pre-existing rows stay
  /// NULL. Lives and dies with the User row.
  visitBoundaryAt DateTime?

  /// R1/T3 — a fifth account-owned relation, cascading like the four
  /// above.
  countryFollows     CountryFollow[]
  watchSubscriptions WatchSubscription[]

  /// MY INTELLIGENCE R1 — Saved Stories, cascading like every other
  /// account-owned relation.
  savedStories          SavedStory[]
  /// INTEREST + SELECTION HOOK R1 — explicit reader interests (governed ids only).
  intelligenceInterests UserIntelligenceInterest[]
  /// HOME R1 STAGE B — Discussion and in-app Alerts (all cascade with the account).
  storyComments         StoryComment[]
  storyCommentReports   StoryCommentReport[]
  storyAlerts           StoryAlert[]
  inboxCursor           UserInboxCursor?

  /// R3/T7 — account-scoped telemetry. SET NULL, NOT Cascade (CTO
  /// decision): deleting an account severs the link to the person while
  /// leaving aggregate history true. See the ProductEvent model.
  productEvents ProductEvent[]

  @@index([adminRole])
}

/// R1/T3 — an authenticated user's followed countries.
///
/// A DEDICATED TABLE, NOT A PREFERENCE JSON COLUMN. JSON cannot express
/// the composite unique below, cannot be indexed for "who follows PL",
/// cannot be bounded by the database, and would have to be re-parsed and
/// re-validated on every read.
///
/// Mirrors SearchHistoryEntry almost exactly, so it introduces no new
/// pattern: userId from the session, cascade from User, createdAt.
///
/// RETENTION: cascade-deleted with the User row. Followed countries are
/// user-declared interests — low sensitivity, but personal data, and
/// they are covered by the same one-operation deletion path as every
/// other account-owned table.
model CountryFollow {
  id String @id @default(uuid())

  userId String

  /// Canonical ISO-3166 alpha-3, validated against ALL_ISO3_CODES in
  /// shared/src/countries.ts BEFORE any write. Never free text, and
  /// never a country name.
  countryCode String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Makes a repeat follow a database-level no-op rather than a matter
  /// of application politeness.
  @@unique([userId, countryCode])
  @@index([userId])
}

/// R3/T7 — the product event vocabulary.
///
/// Twelve names. A name outside this enum cannot be stored: the ingest
/// DTO validates against the same list, so the table cannot accumulate
/// junk names.
enum ProductEventName {
  today_view
  today_item_open
  country_filter
  world_map_open
  analysis_started
  analysis_completed
  evidence_open
  source_open
  follow_created
  follow_removed
  return_visit
  language_selected
}

/// R3/T7 — append-only product telemetry.
///
/// APPEND-ONLY IS A PROPERTY OF THE CODE, NOT A HOPE: TelemetryService
/// contains no update, no upsert and no delete path, and a spec asserts
/// that it never grows one.
///
/// WHAT THIS TABLE CANNOT HOLD, BY CONSTRUCTION — there is no column for
/// an email address, a raw IP, a raw user-agent, an article title, a URL
/// or any other free text. Every dimension below is an enumeration, an
/// ISO3 code, a language code or an identifier. No third-party analytics
/// SDK and no advertising tracker exists anywhere in this platform.
///
/// RETENTION: 90 days. DECLARED, NOT YET ENFORCED — this backend has no
/// scheduler, so no purge job ships with R3. The rule is recorded here,
/// where the columns are, rather than only in a document that can drift
/// away from the code.
model ProductEvent {
  id String @id @default(uuid())

  name ProductEventName

  /// NULL for every event that is not ACCOUNT-SCOPED.
  ///
  /// Only follow_created, follow_removed and return_visit are
  /// account-scoped. Every other event is stored anonymously EVEN WHEN A
  /// VALID SESSION IS PRESENT — the ingest path discards the session
  /// rather than storing it. The one list lives in
  /// modules/telemetry/account-scoped-events.ts so it cannot drift.
  userId String?

  /// SET NULL, not Cascade (CTO decision). Deleting an account severs
  /// the link to the person; the row survives anonymously so historical
  /// aggregate counts stay true rather than being silently rewritten.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// ISO-3166 alpha-3, validated against ALL_ISO3_CODES.
  countryCode String?

  /// A supported UI language code.
  language String?

  /// An article identifier, when the event is about one article. NEVER a
  /// title, a URL or a body.
  ///
  /// AGGREGATE USE ONLY. Article.id is derived from buildStableId(url),
  /// a 32-bit rolling hash with real collision potential at scale, so no
  /// Return or "since" logic may key on it — R0 §6 reaches the same
  /// conclusion and keys on url + firstSeenAt instead. Telemetry is
  /// aggregate and tolerates a rare collision; correctness logic is not
  /// and does not.
  subjectId String?

  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

/// R3/T7 — server-derived analysis telemetry.
///
/// Written ONLY from the server's own view of a completed request. Every
/// value here comes from AnalysisProvenance, which the analysis pipeline
/// already produces on every response; nothing is client-reported.
///
/// NO userId COLUMN, DELIBERATELY. POST /analysis/news is
/// unauthenticated, and an analysis is not an account-scoped event under
/// the linkage rule above. Omitting the column removes the possibility
/// rather than relying on nobody populating it.
///
/// NO COST COLUMN, DELIBERATELY. No price table exists anywhere in this
/// repository — verified by sweep, and independently recorded in the
/// accepted Data Capability Matrix. Tokens and latency are what is
/// measurable today; monetary conversion is deferred until a documented
/// price source exists. A nullable cost column that nothing ever filled
/// would eventually be rendered as a zero by somebody who did not read
/// this comment.
///
/// RETENTION: 90 days. DECLARED, NOT YET ENFORCED — see ProductEvent.
model AnalysisRun {
  id String @id @default(uuid())

  /// AnalysisProvenance.provider — e.g. "openai", "mock-analysis".
  provider String

  /// AnalysisProvenance.model. Absent for mock analysis.
  model String?

  /// success | failed | validation-rejected | not-attempted
  status String

  /// The coarse, provider-agnostic AnalysisFailureReason. NEVER raw
  /// provider error text.
  failureReason String?

  latencyMs Int?

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  /// Served from the in-memory cache rather than freshly computed. This
  /// is the cache hit/miss signal the capability matrix records as
  /// requiring new schema.
  cached Boolean

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
}

model UserIdentity {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SearchHistoryEntry {
  id          String   @id @default(uuid())
  userId      String
  query       String
  countryCode String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// Support loop S1 — what a user says their request is about.
///
/// Mirrors SupportCategory in shared/src/support.ts member for member;
/// supportContract.spec.ts reads both files and fails on any drift.
enum SupportCategory {
  NEWS_QUESTION
  BUG_REPORT
  CONTENT_REPORT
  FEEDBACK
  ABUSE_REPORT
  ACCOUNT_PROBLEM
  OTHER
}

/// Support loop S1 — where a ticket stands.
///
/// RESOLVED is reachable only by a human action. S1 ships no code that
/// writes any status at all; the default below is the only value this
/// milestone can produce.
enum SupportTicketStatus {
  OPEN
  AWAITING_USER
  AWAITING_ADMIN
  RESOLVED
}

/// Support loop S1 — who may read a message.
///
/// INTERNAL is an admin-only note. This is a STORED, NOT NULL column so
/// that user-facing reads can filter on it in the WHERE clause. A note
/// hidden only by the client is not hidden.
enum SupportMessageVisibility {
  PUBLIC
  INTERNAL
}

/// Support loop S1 — who wrote a message.
///
/// SYSTEM_AI is distinct from ADMIN so machine output can never be
/// presented as a human reply, to either party.
enum SupportAuthorType {
  USER
  ADMIN
  SYSTEM_AI
}

/// Support loop S1 — one support request.
///
/// OWNERSHIP IS THE WHOLE POINT. userId is required and cascades from
/// User, so a ticket cannot exist without an owner and DELETE
/// /users/me removes it with the rest of the account (CTO Option A).
/// Every user-facing read in S2 will be scoped to this column.
///
/// `reference` is the opaque GN- identifier declared in
/// shared/src/support.ts. It is @unique so a generator collision
/// becomes a database error and a retry, never a duplicate. S1 creates
/// no reference: nothing here generates or consumes one.
model SupportTicket {
  id        String              @id @default(uuid())
  reference String              @unique
  userId    String
  category  SupportCategory
  status    SupportTicketStatus @default(OPEN)
  subject   String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
}

/// Support loop S1 — one message on a ticket, from a user, an
/// administrator, or the machine.
///
/// TWO DELIBERATE DECISIONS, BOTH LOAD-BEARING.
///
/// 1. `visibility` is NOT NULL and defaults to PUBLIC. An admin reply
///    that somehow omitted the field would become user-visible rather
///    than accidentally internal: a note that leaks is a breach, a
///    reply the user can see is at worst noise. S2's admin route will
///    still require the field explicitly — the default exists so the
///    column can never be null, not as an input convenience.
///
/// 2. `authorId` carries NO relation to User, and that is a decision
///    rather than an omission (CTO-approved). A second cascading
///    foreign key to User would mean deleting an ADMINISTRATOR's
///    account silently deletes their replies out of other users'
///    ticket threads — destroying one person's correspondence as a
///    side effect of an unrelated deletion. The cost is real and
///    accepted: referential integrity on this column is weaker, and
///    S2 must treat an author id with no surviving account as an
///    ordinary case, never an error.
model SupportMessage {
  id         String                   @id @default(uuid())
  ticketId   String
  authorType SupportAuthorType
  authorId   String?
  visibility SupportMessageVisibility @default(PUBLIC)
  body       String
  createdAt  DateTime                 @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

/**
 * ──────────────────────────────────────────────────────────────────────
 * SITUATION MEMORY SUBSTRATE — recovered VERBATIM from the accepted
 * authority (canonical worktree alpha-convergence-2-20260830-133946) under
 * MAIN-FINAL-CORRECTED-ALPHA-CONVERGENCE-1 PO ruling 1. NOT ONE FIELD IS
 * INVENTED, RENAMED OR RETYPED. Its migration,
 * 20260901050000_add_situation_memory, creates five NEW tables and alters no
 * existing one; DOWN.sql beside it drops exactly those five.
 * ──────────────────────────────────────────────────────────────────────
 */

/// The thing a user follows and the system remembers across retrieval cycles.
model Situation {
  id String @id @default(uuid())

  /// TIER 1 — G'S BUCKET KEY. `sit:v1:<sorted ISO3 scope, or 'world'>`.
  ///
  /// DELIBERATELY NOT UNIQUE. G's contract states the asymmetry that decides
  /// it: a FALSE SPLIT is unrecoverable and invisible — two halves of one
  /// situation get two identities and nothing can detect it happened — while a
  /// FALSE MERGE INSIDE A BUCKET is caught, because tier 2 compares against the
  /// bucket's anchors and separates it, and the comparison is recorded. So the
  /// key errs coarse on purpose. Its job is to make a fallible relation
  /// BOUNDED: an observation is compared only against situations sharing its
  /// partition, never against the whole history.
  ///
  /// Recomputed per observation from that observation alone. Never treated as
  /// a situation's identity.
  partitionKey String

  /// G'S SITUATION_KEY_VERSION, PERSISTED PER ROW — currently 'v1'.
  ///
  /// G's invariant 3, and it is not bookkeeping. A change to any derivation
  /// rule bumps the version, and a v1 situation must never be matched against
  /// a v2 key. Without the version stored beside the key, a rule change
  /// silently re-partitions the whole history and every continuity claim made
  /// before the change quietly becomes a claim about a different partition.
  keyVersion String

  /// THE SITUATION'S ACTUAL IDENTITY WITHIN ITS BUCKET. ASSIGN-ONCE.
  ///
  /// G's invariant 2: assigned exactly once, at situation creation, and NEVER
  /// recomputed. Recomputing it from the current member set would reintroduce
  /// precisely the set-dependence G's contract exists to eliminate — the key
  /// would change every retrieval cycle because the set changes every
  /// retrieval cycle.
  ///
  /// It is OPAQUE and collision-free by construction rather than derived from
  /// the seed observation's text. That is deliberate: a text-derived
  /// discriminator under the unique index below would REJECT a second
  /// situation whose seed happened to read alike, which is a false merge
  /// imposed by a constraint. The audit trail — what the seed actually was —
  /// lives in the seed* columns, which carry no uniqueness.
  ///
  /// Enforced immutable at the database level by the trigger this migration
  /// installs, not merely by the repository's good behaviour.
  discriminator String

  /// The rule under which `discriminator` was assigned, so a future change to
  /// that rule is detectable in the data instead of being invisible.
  discriminatorBasis String

  /// PROVENANCE OF THE SEED — the observation that opened this situation.
  /// Assign-once, like the discriminator. Article URL, not article id:
  /// shared/src/news.ts documents `id` as a 32-bit rolling hash and unsafe as
  /// a key, and `url` is what the Article table is unique on.
  seedArticleUrl String
  seedObservedAt DateTime

  /// ISO-3166 alpha-2 when the situation is country-anchored. Optional because
  /// not every situation is, and absence must never be read as "global".
  /// Only ever filled in, never overwritten with null: a later analysis that
  /// could not establish a country is not evidence the earlier one was wrong.
  countryCode String?

  firstObservedAt DateTime @default(now())

  /// THE TWO TIMESTAMPS, AND THEY ARE TWO COLUMNS ON PURPOSE.
  ///
  /// "We looked and nothing material moved" and "we have not looked" are
  /// different facts, and a single column cannot hold both. Retrieval touches
  /// lastRetrievedAt only; only a completed analysis touches lastAnalysedAt.
  ///
  /// NULL MEANS NEVER. Not "unknown", not "a long time ago". The columns are
  /// nullable so that case has its own value rather than being faked with an
  /// epoch date that later reads as a real measurement.
  lastRetrievedAt DateTime?
  lastAnalysedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots SituationSnapshot[]

  /// THE IDENTITY CONSTRAINT, AND IT IS THE TRIPLE — NOT THE KEY.
  ///
  /// Many situations may share a partition; none may share the full triple.
  /// This is what replaces S1's `key @unique`, and it is the only uniqueness
  /// this model asserts.
  @@unique([partitionKey, keyVersion, discriminator])
  /// The bounded lookup G's write path performs: load the situations in this
  /// observation's bucket, at this key version, and nothing else.
  @@index([partitionKey, keyVersion])
  @@index([countryCode])
  @@index([lastAnalysedAt])
}

/// One completed analysis of one situation, at one instant. APPEND-ONLY.
model SituationSnapshot {
  id String @id @default(uuid())

  situationId String
  situation   Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)

  /// When the analysis COMPLETED — not when the request arrived, and not when
  /// the row was written.
  analysedAt DateTime

  /// STORED rather than recomputed on read. The comparison that produced it
  /// had both snapshots in hand at a known instant; a reader months later
  /// would be re-deriving it from whatever the history looks like then.
  ///
  /// FIRST_OBSERVATION · MATERIAL_CHANGE · STABLE · INCOMPARABLE.
  /// One snapshot NEVER proves STABLE — see situation.state.ts, where each
  /// clause of that ruling is a separate guard.
  state String

  /// Dimension VALUES, never the prose. Prose would make every re-run
  /// "different" for reasons that have nothing to do with the subject having
  /// changed — the exact false positive this store exists to avoid. Enforced,
  /// not merely intended: see assertComparableDimensions.
  dimensions Json

  /// OPTIONAL TRACE to the AnalysisRun telemetry row for the same request.
  /// A POINTER, DELIBERATELY NOT A FOREIGN KEY. AnalysisRun is telemetry and
  /// is subject to retention rules this store has no say over; a real FK would
  /// mean either that trimming telemetry cascades into deleting analysis
  /// history, or that telemetry can never be trimmed. Both are worse than a
  /// pointer that may dangle, so readers must treat a miss as ordinary.
  analysisRunId String?

  createdAt DateTime @default(now())

  clusters SituationCluster[]

  @@index([situationId, analysedAt])
  @@index([analysedAt])
}

/// One story, as carried by several publishers, within one snapshot.
model SituationCluster {
  id String @id @default(uuid())

  snapshotId String
  snapshot   SituationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// G-owned derivation. Main stores it and enforces uniqueness within the
  /// snapshot; Main does not decide what it means.
  clusterKey String

  /// The number of DISTINCT PUBLISHERS behind the members. Stored as supplied
  /// rather than recomputed, because publisher identity is G-owned (C2-5) and
  /// this layer must not re-derive it from the URL and get a different answer.
  publisherCount Int

  /// The number of members actually written, so the count and the rows cannot
  /// disagree.
  memberCount Int

  createdAt DateTime @default(now())

  members SituationClusterMember[]

  @@unique([snapshotId, clusterKey])
}

/// One article's membership of one cluster.
model SituationClusterMember {
  id String @id @default(uuid())

  clusterId String
  cluster   SituationCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  /// ARTICLE URL, NOT ARTICLE ID. shared/src/news.ts states `id` is derived
  /// from a 32-bit rolling hash and is not a safe key; `url` is what the
  /// Article table is unique on and what persistMany upserts against.
  /// Deliberately NOT a foreign key to Article: article retention is not this
  /// store's concern, and losing an article must not delete the record that
  /// it was once evidence.
  articleUrl String

  createdAt DateTime @default(now())

  @@unique([clusterId, articleUrl])
  @@index([articleUrl])
}

/// ----------------------------------------------------------------------------
/// TIER 2, IN SHADOW ONLY.
///
/// G measured the continuity policy's separation margin at 0.042 — lowest true
/// positive 0.375, highest true negative 0.333 — over eighteen hand-built
/// pairs, and declined to certify a threshold from it. This table is what
/// "shadow mode" means concretely: every attachment decision is COMPUTED and
/// RECORDED, and NONE of it governs anything a reader sees.
///
/// A false merge acted on in production is a reader shown two unrelated
/// matters as one continuing situation. A false merge recorded here is a row.
///
/// THE POLICY AND ITS THRESHOLD ARE STORED ON EVERY ROW. Without them a
/// gathered distribution is uninterpretable the moment the policy changes —
/// which it will, because gathering the distribution is the whole point.
/// ----------------------------------------------------------------------------
model SituationShadowDecision {
  id String @id @default(uuid())

  /// When the decision was computed.
  decidedAt DateTime

  /// The bucket the observation fell in, and the key version that produced it.
  partitionKey String
  keyVersion   String

  /// OBSERVATION IDENTITY. Article URL, for the same reason as cluster
  /// membership: `id` is a rolling hash and is not a safe key.
  observationUrl String

  /// THE CANDIDATE, when there was one. Nullable, because an empty bucket is a
  /// perfectly ordinary outcome and must be recorded as itself rather than
  /// omitted — a distribution missing its no-candidate cases is a biased one.
  ///
  /// Deliberately NOT a foreign key, and the discriminator is stored beside
  /// the id: the record of what was compared must survive the candidate's
  /// deletion, or the shadow corpus silently loses its negatives.
  candidateSituationId   String?
  candidateDiscriminator String?
  anchorArticleUrl       String?

  /// The similarity the policy computed. Null only when there was no candidate
  /// to score — never 0, which is a real score and a different fact.
  score Float?

  /// ATTACH_RECOMMENDED · OPEN_NEW_RECOMMENDED · NO_CANDIDATE.
  /// A RECOMMENDATION, never an action. Nothing reads this column to decide
  /// what a user sees.
  recommendation String

  /// G's own reason string, and the features the score was computed from, so a
  /// row can be re-examined without re-running the pipeline that produced it.
  reason   String
  features Json

  /// WHICH policy, at WHICH threshold. See the note above the model.
  policyId        String
  policyThreshold Float

  /// Always true. A CHECK constraint in the migration forbids false, so a
  /// shadow row cannot quietly be promoted into an authoritative one by an
  /// UPDATE somebody thought was harmless.
  shadowOnly Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([partitionKey, keyVersion, decidedAt])
  @@index([decidedAt])
  @@index([candidateSituationId])
}

// ============================================================================
// OFFICIAL-DATA SNAPSHOT RETENTION — P-2, THE FOUR PERSISTENCE MODELS.
//
// Contract: shared/src/official-data/snapshot.ts (SR-1 … SR-22).
// Substrate: Postgres `Bytes`, by Product Owner decision P-1.
//
// FOUR MODELS, AND THE NAMES ARE MAIN'S, NOT CHOSEN HERE. P-2 of
// MAIN-OFFICIAL-DATA-SNAPSHOT-RETENTION-R1 §2 names them exactly:
// SnapshotPayload, SnapshotRetrieval, SnapshotPin, SnapshotTombstone.
//
// WHY FOUR TABLES AND NOT ONE. Postgres could hold all of this in one row, and
// that is precisely the shape the contract refuses. The four concerns have
// different cardinalities and different lifetimes:
//
//   bytes          one per DISTINCT BODY        immutable, sometimes collected
//   retrieval      one per FETCH                append-only, never deleted
//   pin            one per CITATION             created and released, not deleted
//   tombstone      one per COLLECTION           terminal, never deleted
//
// Collapsing them loses SR-3/SR-4 outright: "fetch the same unchanged dataset
// twice" must cost one row and zero bytes, and it cannot if the bytes live on
// the retrieval row.
//
// WHERE REQUEST IDENTITY LIVES, AND WHY IT IS NOT A FIFTH TABLE. Main's
// contract nests `OfficialDataRequestIdentity` INSIDE `OfficialDataRetrieval`
// — one fetch is one request — and P-2 names four models, not five. So the
// request is carried as columns on SnapshotRetrieval. It is still structure and
// never a URL: providerId, endpointId and a provider-relative path are separate
// columns, and the parameters are an ORDERED JSON ARRAY of {key,value} pairs
// rather than a query string. SR-22's credential refusal operates on that
// structure, which is what makes it enforceable at all.
// ============================================================================

/// SR-1 · IDENTITY IS THE BYTES. One row per DISTINCT BODY, addressed by the
/// lowercase-hex SHA-256 of the exact bytes as received.
///
/// THE ADDRESS IS THE PRIMARY KEY, not a uuid with a unique index beside it.
/// That is what makes SR-4 free: a second fetch of unchanged bytes collides on
/// the key and writes nothing, rather than needing a lookup-then-insert race.
model SnapshotPayload {
  /// 64 lowercase hex characters. Computed BY THE STORE from the bytes it
  /// holds — SR-2 — never supplied by a caller.
  contentAddress String @id

  /// THE RETAINED BYTES. Nullable, and the two reasons it may be null are
  /// different facts kept distinct by `storageState` below:
  ///   - NOT_RETAINED_BY_RIGHTS — the publisher's terms forbade retention, so
  ///     the bytes were hashed and measured but never written;
  ///   - COLLECTED — the bytes were removed under a named policy, and a
  ///     SnapshotTombstone records that they existed.
  /// "There is no snapshot" is a third and much weaker fact, and it is the one
  /// this column is shaped never to be confused with.
  bytes Bytes?

  /// Byte length of the bytes that produced the address. Survives collection,
  /// so a tombstoned payload still reports how big the evidence was.
  byteLength Int

  /// The media type the publisher returned, verbatim from the header. Never
  /// inferred from an extension and never from the body.
  mediaType String

  /// STORAGE DISPOSITION — R2 · FOUR values: RETAINED, COLLECTED,
  /// NOT_RETAINED_BY_RIGHTS, NOT_RETAINED_BY_QUARANTINE.
  ///
  /// PINNED IS DELIBERATELY NOT ONE OF THEM. The contract's PINNED retention
  /// class is DERIVED from the pin table at read time, because a denormalised
  /// PINNED flag can drift out of step with the pins that justify it — and a
  /// payload wrongly believed unpinned is exactly the byte that gets collected.
  /// See `retentionClassOf()` in the store.
  ///
  /// R2 · SNAP-R2-12 adds NOT_RETAINED_BY_QUARANTINE, and A-24 is why it is a
  /// FOURTH value rather than being folded into NOT_RETAINED_BY_RIGHTS. "The
  /// publisher's terms forbade retention" and "the body contained a configured
  /// secret" are different facts with different remedies: the first is a rights
  /// position that may change, the second is an incident. A reader who cannot
  /// tell them apart cannot act on either.
  ///
  /// NOTE THAT A QUARANTINED CAPTURE USUALLY HAS NO PAYLOAD ROW AT ALL — the
  /// scan runs before any byte is committed. This value exists for the case
  /// where an address was already known from an earlier clean capture of the
  /// same bytes.
  storageState String @default("RETAINED")

  /// When these bytes were first seen. A second, identical fetch does not
  /// change it — that is what `retrievals` is for.
  firstRetainedAt DateTime @default(now())

  retrievals SnapshotRetrieval[]
  pins       SnapshotPin[]
  tombstone  SnapshotTombstone?

  @@index([storageState, firstRetainedAt])
}

/// SR-3 · ONE FETCH, ONE ROW. Every retrieval is its own record even when it
/// produced bytes that were already held.
///
/// NO CASCADE FROM THE PAYLOAD, ON PURPOSE. Section 4 of the retention policy
/// forbids deleting a retrieval row at all, so there is no delete for a cascade
/// to follow; collection nulls the bytes and leaves every row standing.
model SnapshotRetrieval {
  /// Caller-supplied and unique per fetch — the contract's `retrievalId`.
  retrievalId String @id

  // REQUEST IDENTITY — SR-22 operates on these.

  /// As the official-source registry names it. NEVER a hostname.
  providerId String

  /// The provider's own endpoint/dataflow identifier, verbatim.
  endpointId String

  /// Provider-relative. No scheme, no host, no query — refused if it contains
  /// either, because a URL here would smuggle parameters past the credential
  /// check that only reads `parameters`.
  requestPath String

  /// ORDERED array of {key, value}. An array rather than an object so the
  /// order sent is the order recorded, and pairs rather than a query string so
  /// a later reader sees exactly what was pinned.
  parameters Json

  /// When the request was dispatched.
  requestedAt DateTime

  // RESULT.

  /// When the response completed or failed.
  retrievedAt DateTime

  httpStatus Int

  /// The type the publisher returned. Cross-checked against the payload's in
  /// `parseRetained()`.
  mediaType String

  /// R2 · the DECODED length — SR-1 (R2). The wire length is transport evidence
  /// and lives in `wireByteLength` below.
  byteLength Int

  /// R2 · Absent when no bytes arrived (completeness FAILED) OR when the capture
  /// was QUARANTINED — SNAP-R2-12.
  ///
  /// A body containing a configured secret is never committed, and NO ADDRESS IS
  /// RECORDED for bytes that were discarded. Two reasons, and the second is the
  /// sharper one: an address over bytes we do not hold is the same unverifiable
  /// claim SNAP-R2-3 refuses for the wire digest — with the added hazard that
  /// THE HASH OF A BODY KNOWN TO CONTAIN A SPECIFIC SECRET IS ITSELF A
  /// CONFIRMATION ORACLE.
  contentAddress String?
  payload        SnapshotPayload? @relation(fields: [contentAddress], references: [contentAddress])

  /// COMPLETE, TRUNCATED or FAILED. TRUNCATED exists because the streaming byte
  /// cap aborts mid-body, and a capped response must never be mistaken for a
  /// short one.
  ///
  /// R2 · SNAP-R2-5 — THIS IS E1's `captureOutcome`, UNDER THE NAME IT ALREADY
  /// HAD. It is not renamed and no second column is added beside it: that would
  /// record one fact under two names. The pair (completeness, admissibility)
  /// satisfies E1's structural requirement exactly, because neither is inferable
  /// from the other — a COMPLETE capture can be REFUSED for host mismatch, and a
  /// TRUNCATED capture is always REFUSED.
  completeness String

  // ── R2 · TRANSPORT EVIDENCE — SNAP-R2-3. NEVER AN IDENTITY. ──────────────

  /// As received: 'identity' or 'gzip'. Recorded because the wire shape is the
  /// only way to notice a transport-layer surprise afterwards.
  contentEncoding String @default("identity")

  /// Octets ON THE WIRE, before decode. Equals `byteLength` under identity.
  ///
  /// AND THERE IS NO WIRE DIGEST — a ruling, not an omission. A hash over bytes
  /// the store does not retain can never be re-verified, which is the exact
  /// inverse of SR-11's no-forge property wearing its clothes.
  wireByteLength Int?

  // ── R2 · THE ADMISSION VERDICT — E1 S-1/S-2/S-3 ──────────────────────────

  /// REFUSED or ADMITTED, and it lives HERE rather than on the payload —
  /// SNAP-R2-6.
  ///
  /// ADMISSIBILITY IS A PROPERTY OF A CAPTURE, NOT OF BYTES. Two providers can
  /// serve byte-identical JSON and one may fail the provenance check; on the
  /// payload, one provider's admission would launder the other's refusal.
  ///
  /// DEFAULT 'REFUSED' IS THE POINT OF S-1, NOT A CONVENIENCE: there is no path
  /// where the ABSENCE of a refusal produces admission.
  admissibility String @default("REFUSED")

  /// Present exactly when REFUSED. One of the thirteen contract keys.
  refusalKey String?

  /// PERMANENT or TRANSIENT — S-5, and ONLY TRANSIENT MAY RETRY. G measured the
  /// failure this prevents: a 404 is a permanent configuration error, and on a
  /// retry loop it reports as a transient provider outage.
  refusalClass String?

  // ── R2 · THE PARSE RECORD — P-4/P-5 ──────────────────────────────────────

  /// Present exactly when ADMITTED; nothing else is parsed. Without the version
  /// a parser upgrade changes MEANING without changing BYTES, undetectably.
  parserId      String?
  parserVersion String?
  parsedAt      DateTime?

  // RIGHTS, FROZEN AT RETRIEVAL — SR-18.

  /// The lane's rights grade for this provider AT THE TIME OF THIS FETCH.
  rightsGrade String

  /// The citable instrument the grade rests on. A grade without its instrument
  /// is an opinion.
  rightsInstrumentRef String

  /// Whether the publisher's terms permitted retaining the bytes. `false` is
  /// legitimate and has consequences — `retrievalIsReproducible()` reports them
  /// rather than swallowing them.
  payloadRetentionPermitted Boolean

  // PUBLISHER EDITION METADATA — SR-9, SR-10.

  /// VERBATIM AND OPAQUE. For Eurostat this carries UPDATE_DATA, OBS_COUNT,
  /// OBS_PERIOD_OVERALL_LATEST and DOI. The platform stores them and NEVER
  /// interprets them: which edition is newer is provider semantics — SR-13.
  editionAnnotations Json

  /// Where the publisher declares one. ABSENT rather than guessed.
  publisherReleasedAt DateTime?

  /// Where the publisher declares one. ABSENT rather than guessed.
  publisherChangedAt DateTime?

  /// NISR PRODUCTIONIZATION R1 · ruling A. The interval the artifact is ABOUT, as
  /// the ARTIFACT ITSELF stated it, AT THE PUBLISHER’S OWN PRECISION.
  ///
  /// TEXT, NOT DateTime, AND THIS IS THE LOAD-BEARING DECISION. The observed value
  /// is `2026-08` — a MONTH. A timestamp column cannot hold a month: it manufactures
  /// `2026-08-01T00:00:00Z`, a day the publisher never stated, and no reader
  /// downstream can tell a manufactured day from a stated one. VARCHAR carries the
  /// publisher’s own precision unchanged.
  ///
  /// NULL = the document did not state one, which is the truthful and FINAL value
  /// for every JSON dataflow forever — a Eurostat response carries a whole time
  /// axis, not one period. Never a filename, never an upload folder (R-AID-1).
  referencePeriod String? @db.VarChar(32)

  /// NISR PRODUCTIONIZATION R1 · ruling A. The language of the artifact EDITION, as
  /// OBSERVED from the bytes — never a declared locale tag, an hreflang or a locale
  /// in a path, all of which are CLAIMS a publisher makes about a file.
  ///
  /// 35 is BCP-47’s own maximum tag length: a bound, not a validator. NULL = not
  /// established.
  sourceLanguage String? @db.VarChar(35)

  /// NISR PRODUCTIONIZATION R1 · ruling B-3.1. WHICH EXTRACTION PRODUCED THE LAYER
  /// THE PARSER READ — `nisr.cpi.<library>.<strategy>`.
  ///
  /// The extractor seam exists so an injected extraction cannot change what a parser
  /// MEANS without the change being detectable. Before this column the identity was
  /// computed and then discarded, which made the seam’s central promise decorative:
  /// P-4’s hazard is an AFTER-THE-FACT hazard, so the answer has to survive the
  /// request.
  ///
  /// NULL for every JSON parse — a JSON parse has no extractor. Same class as
  /// parserId / parserVersion / parsedAt above.
  extractorId String? @db.VarChar(128)

  /// NISR PRODUCTIONIZATION R1 · ruling B-3.1. The extraction implementation’s own
  /// version, ASSERTED AT BOOT rather than declared: the composition root refuses to
  /// install an extractor whose declared version does not match the integrity of the
  /// code that produces the layer, so a change without a version bump fails the
  /// deployment instead of mis-attributing rows.
  extractorVersion String? @db.VarChar(64)

  createdAt DateTime @default(now())

  observations         MarketObservation[]
  energyObservations   EnergyObservation[]
  conflictObservations ConflictObservation[]

  /// R2 · S-3 — THE COMPOSITE KEY AN OBSERVATION REFERENCES.
  ///
  /// `retrievalId` is already unique on its own, so this index adds no row-level
  /// constraint. Its whole job is to be a VALID FOREIGN-KEY TARGET for the pair
  /// (retrievalId, admissibility) — which is what lets an observation table pin
  /// its own column to 'ADMITTED' and have the database refuse the join to a
  /// REFUSED capture. Without this index the foreign key cannot be declared at
  /// all, and the guarantee would fall back to application code.
  @@unique([retrievalId, admissibility])
  @@index([contentAddress, retrievedAt])
  @@index([providerId, endpointId, retrievedAt])
  @@index([retrievedAt])
  @@index([admissibility, retrievedAt])
}

/// SR-19 · WHAT MAKES THIS AN EVIDENCE STORE RATHER THAN A CACHE.
///
/// A payload is PINNED while any unreleased pin cites it. `citedBy` is an
/// observation lineage key and NEVER free text: a pin whose reason is prose
/// cannot be re-derived, and a pin that cannot be re-derived cannot be safely
/// released.
model SnapshotPin {
  id String @id @default(uuid())

  contentAddress String
  payload        SnapshotPayload @relation(fields: [contentAddress], references: [contentAddress])

  /// The observation lineage key of the published figure that cites these
  /// bytes.
  citedBy String

  pinnedAt DateTime

  /// RELEASED, NOT DELETED. Un-publishing makes a payload eligible after the
  /// grace window rather than collected on the spot, so republishing inside the
  /// window costs nothing and a mistaken un-publish is recoverable. A deleted
  /// pin row would erase the very timestamp the grace period is measured from.
  releasedAt DateTime?

  /// One citation pins once. Re-citing the same figure is idempotent, not a
  /// second pin that must later be released twice.
  @@unique([contentAddress, citedBy])
  @@index([contentAddress, releasedAt])
}

/// SR-20 · COLLECTION REMOVES BYTES, NEVER THE RECORD.
///
/// So a later reader learns "evidence existed, was this size and this type, and
/// was collected under policy P on date D" — a different and far more useful
/// fact than "there is no snapshot".
model SnapshotTombstone {
  /// One collection per payload, so the address is the key.
  contentAddress String          @id
  payload        SnapshotPayload @relation(fields: [contentAddress], references: [contentAddress])

  /// Carried on the tombstone as well as the payload, so the record is
  /// self-describing if it is ever read alone.
  byteLength Int
  mediaType  String

  collectedAt DateTime

  /// The NAMED policy that authorised it. Never free text, and there is no
  /// `force` anywhere in this contract.
  policyId String

  @@index([collectedAt])
}

// ============================================================================
// MARKET SCHEDULED INGEST — MKT-PLAT-2, THE MINIMAL PERSISTENCE SET.
//
// Contract: MAIN-MARKET-LINEAGE-SCHEDULED-INGEST-R1 · SI-6, SI-7, SI-9, SI-10, SI-16.
// Declarations: G-MARKET-DATA-ACQUISITION-R2.
//
// THREE MODELS, AND DELIBERATELY NOT A FOURTH. Main's D-10 needs a run record, a
// lease and an observation. It does NOT need a Market payload table, and adding
// one would be the duplication the brief warns against:
//
//   Economy's SnapshotPayload holds RAW PROVIDER BYTES so a published figure can
//   be re-proved. That is a platform capability with its own rights, retention and
//   pinning rules, and it was built once.
//
//   MarketObservation holds a PARSED READING. Different purpose, different
//   lifetime, different consumer.
//
// So Market does not get its own byte store: a MarketObservation POINTS AT a
// snapshot content address when its adapter retained one. Two tables for one
// concern would mean two answers to "which bytes is this figure from".
//
// AND NO MARKET OBSERVATION VOCABULARY IS CREATED. SI-7.1 reuses ECON-CONTRACT-1's
// Series -> Period -> Observation spine, and the accepted C51 guard forbids
// MarketSeries, MarketPeriod, MarketObservation-as-a-TYPE, MarketReleaseStatus,
// MarketValueKind and MarketFreshness. The TABLE below is storage for readings
// acquired by the Market lane; the SEMANTICS are Economy's, unchanged.
// ============================================================================

/// SI-6.1 · ONE RUN PER (provider, subjectClass, cadenceWindow, triggerKind).
///
/// The run record is what makes a scheduled system auditable: it says a fetch was
/// attempted, what triggered it, and how it ended — including the endings that
/// produced nothing.
model MarketIngestRun {
  id String @id @default(uuid())

  /// The length-prefixed encoding of the four identity parts. UNIQUE, and that
  /// uniqueness IS the idempotency guarantee — re-running a window collides here
  /// rather than relying on the caller to check first.
  runKey String @unique

  providerId   String
  subjectClass String

  /// SI-6.1 — the window this run is for. A window, never a wall-clock instant:
  /// idempotency keyed on time would make two runs a millisecond apart distinct.
  cadenceWindow String

  /// SCHEDULED · MANUAL_AUTHORISED · BACKFILL · RETRY.
  /// There is NO user-request kind, by SI-1.2, and none can be added here without
  /// changing the scheduler's own union.
  triggerKind String

  /// Required for MANUAL_AUTHORISED. An unattributed manual run is not authorised.
  authorisedBy String?

  startedAt  DateTime
  finishedAt DateTime?

  /// SI-16.2, the closed set: SUCCEEDED · NO_NEW_DATA · DEFERRED · TIMED_OUT ·
  /// TRANSPORT_FAILED · VALIDATION_FAILED · RIGHTS_REFUSED · PROVIDER_DISABLED ·
  /// CIRCUIT_OPEN.
  ///
  /// NO_NEW_DATA IS NOT NO_MATERIAL_CHANGE. A run that observed nothing and a run
  /// that observed no change are different facts, and collapsing them makes an
  /// outage indistinguishable from a quiet month.
  outcome String?

  attempts            Int @default(0)
  observationsWritten Int @default(0)

  /// Why, in the outcome's own terms. Never a stack trace, never free prose that
  /// a later reader has to interpret.
  detail String?

  observations MarketObservation[]

  createdAt DateTime @default(now())

  @@index([providerId, subjectClass, startedAt])
  @@index([outcome, startedAt])
  @@index([startedAt])
}

/// SI-6.3 · THE LEASE. One owner works a run at a time, and a crashed owner's
/// lease EXPIRES rather than requiring manual clearing.
///
/// WHY EXPIRY RATHER THAN A CLEANUP JOB. A lease that needs a janitor has two
/// failure modes: the worker dies, and the janitor dies. An expiry timestamp has
/// one, and it is checked by the only query that hands out the lease.
model MarketIngestLease {
  id String @id @default(uuid())

  /// One live lease per run key. The unique index is the mutual exclusion; the
  /// expiry is what makes it recoverable.
  runKey String @unique

  /// Which process holds it. Recorded so a stuck lease can be attributed rather
  /// than merely observed.
  owner String

  acquiredAt DateTime
  /// Heartbeated while work continues, so a long legitimate run is not stolen from.
  expiresAt  DateTime

  /// Set when released cleanly. A row with releasedAt is a historical record, not
  /// a live lease — kept because "this run was worked and finished" is evidence.
  releasedAt DateTime?

  @@index([expiresAt])
  @@index([owner, acquiredAt])
}

/// SI-7 · A READING, WITH ITS THREE TIMESTAMPS KEPT APART.
///
/// The semantics are ECON-CONTRACT-1's. This table stores what the Market lane
/// acquired; it invents no vocabulary and re-declares no axis.

/// Retained canonical Conflict observations.
///
/// Complex accepted axes are stored as JSON because their exact structures are
/// governed by shared/src/conflict/observation.ts. Index columns duplicate only
/// stable identity/time/geography selectors for efficient reads; they do not
/// replace or re-derive the canonical values.
model ConflictObservation {
  id                    String             @id @default(uuid())
  observationKey        String
  authority             String
  upstreamEventId       String
  eventType             String
  owner                 String
  actors                Json
  geography             Json
  temporal              Json
  severity              Json
  sourceReference       Json
  acquisition           Json
  revision              Json
  revisionOrdinal       Int                @default(0)
  captureHash           String?
  captureRetrievedAt    DateTime?
  snapshotRetrievalId   String?
  snapshotAdmissibility String?
  snapshotRetrieval     SnapshotRetrieval? @relation(fields: [snapshotRetrievalId, snapshotAdmissibility], references: [retrievalId, admissibility])

  /// Read/index projections bound at write from canonical temporal/geography.
  occurredOn  DateTime
  countryIso3 String?
  ingestedAt  DateTime @default(now())

  @@unique([authority, upstreamEventId, revisionOrdinal])
  @@unique([observationKey, revisionOrdinal])
  @@unique([observationKey, captureHash])
  @@index([occurredOn])
  @@index([countryIso3, occurredOn])
  @@index([authority])
}

model MarketObservation {
  id String @id @default(uuid())

  /// SI-7.2 — the encoded (series, period) key PLUS the provider's own key
  /// dimensions. Length-prefixed, because Comext keys on six parts whose values
  /// contain underscores and digit strings of mixed length — the exact collision
  /// shape the accepted `eco:1` encoding exists to fix.
  ///
  /// SI-7.3 — identity is NEVER derived from a value. Two observations with the
  /// same number are not the same observation.
  observationKey String

  seriesId String
  periodId String

  providerId   String
  subjectClass String

  /// Null is a real reading state — a published gap — not a missing row.
  value Float?
  unit  String

  /// SI-9.1 — THREE TIMESTAMPS, NEVER COLLAPSED.
  /// publisherVintage   when the publisher says the reading is FOR
  /// publisherChangedAt when the publisher says the record CHANGED
  /// ingestedAt         when WE saw it
  publisherVintage   DateTime?
  publisherChangedAt DateTime?
  ingestedAt         DateTime

  /// SI-9.2 — which of the three the value is actually carrying.
  /// PUBLISHER_VINTAGE · PUBLISHER_CHANGED_AT · INGEST_SNAPSHOT.
  /// Bound at write from the provider's seam declaration, never inferred at read.
  /// This is E1 condition M-1 and this column is where it becomes enforceable.
  vintageProvenance String

  /// SI-8.2 — the accepted release-status vocabulary, reused unchanged.
  /// WITHDRAWN is a first-class state and NOT a delete: a withdrawn figure must
  /// stay visible as withdrawn.
  releaseStatus String

  /// SI-10.4 — THE POINTER TO THE RETAINED BYTES, AND IT IS A POINTER ON PURPOSE.
  ///
  /// Not a foreign key to SnapshotPayload. The snapshot store's PIN is what
  /// guarantees those bytes survive; an FK would add a second, weaker guarantee
  /// and would couple two migrations that are deployable independently. A reader
  /// that finds an address and no payload has learned something true — the
  /// tombstone says what happened to it.
  ///
  /// R2 · AND IT IS NO LONGER SUFFICIENT ON ITS OWN. See `snapshotRetrievalId`.
  snapshotContentAddress String?

  /// ══════════════════════════════════════════════════════════════════════
  /// R2 · S-3 — AN OBSERVATION REFERENCES AN ADMITTED **CAPTURE**, NOT BYTES
  /// ══════════════════════════════════════════════════════════════════════
  ///
  /// THE DEFECT THIS CLOSES. Under R1 a Market observation cited
  /// `snapshotContentAddress` alone. Admissibility is a property of a CAPTURE and
  /// not of BYTES — SNAP-R2-6 — so an address-only citation BYPASSES THE ADMISSION
  /// VERDICT ENTIRELY: two providers can serve byte-identical JSON, one of them
  /// failing the provenance check, and a figure citing those bytes could not be
  /// told apart from a figure citing the admitted capture. The refused provider's
  /// capture would be laundered by the admitted one's address.
  ///
  /// So a real observation now names the RETRIEVAL, and the pair below is a
  /// composite foreign key onto `SnapshotRetrieval(retrievalId, admissibility)`.
  ///
  /// NULLABLE, because not every Market observation is snapshot-backed — SI-10.4
  /// makes the snapshot mandatory only for a publisher that does not version its
  /// past data. But an observation that DOES cite one cites an admitted one, and
  /// the database is what enforces that rather than a comment.
  snapshotRetrievalId String?

  /// PINNED TO 'ADMITTED' BY A CHECK CONSTRAINT, AND THAT IS THE MECHANISM.
  ///
  /// It is not a copy of the retrieval's verdict that could drift: it is the
  /// second half of the composite key. Because this column can only ever hold
  /// 'ADMITTED', the foreign key can only ever resolve to a row whose
  /// `admissibility` IS 'ADMITTED'. A REFUSED capture is not rejected by a
  /// trigger here — it is UNREFERENCEABLE.
  ///
  /// Combined with the assign-once trigger on the retrieval, a refused capture
  /// can never be promoted after the fact either. The two together are what make
  /// "a refused capture cannot back a published figure" a property of the
  /// database rather than a property of the code that happens to write to it.
  snapshotAdmissibility String?

  snapshotRetrieval SnapshotRetrieval? @relation(fields: [snapshotRetrievalId, snapshotAdmissibility], references: [retrievalId, admissibility])

  runId String
  run   MarketIngestRun @relation(fields: [runId], references: [id])

  createdAt DateTime @default(now())

  /// SI-6.2 — RE-RUNNING A WINDOW MUST NOT CREATE A SECOND OBSERVATION.
  /// Idempotency keyed on observation identity, never on wall-clock time.
  ///
  /// A REVISION IS NOT A COLLISION: SI-8.1 says a revision APPENDS, and a revised
  /// reading carries a different publisherChangedAt, so it is a different row
  /// under this key. The prior value stays exactly where it was.
  @@unique([observationKey, vintageProvenance, publisherChangedAt])
  @@index([providerId, subjectClass, ingestedAt])
  @@index([seriesId, periodId])
  @@index([snapshotContentAddress])
  @@index([snapshotRetrievalId])
  @@index([runId])
}

/// Internal R2 append-only production ledger. No acquisition or public activation.
model SecurityProjectionRun {
  id            Int                           @id @default(autoincrement())
  geographyId   String
  maxAgeMinutes Int
  startedAt     DateTime                      @default(now())
  completion    SecurityProjectionCompletion?
  observations  SecurityObservation[]
  members       SecurityProjectionMember[]

  @@index([geographyId, id])
}

model SecurityProjectionCompletion {
  runId            Int                   @id
  run              SecurityProjectionRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status           String
  observationCount Int
  completedAt      DateTime              @default(now())
}

model SecurityObservation {
  id                        Int                        @id @default(autoincrement())
  runId                     Int
  run                       SecurityProjectionRun      @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  observationKey            String
  geographyId               String
  revisionOrdinal           Int
  supersedesRevisionOrdinal Int?
  ownershipT1               Boolean
  ownershipT2               Boolean
  resolvedOwner             String
  payload                   Json
  memberships               SecurityProjectionMember[]

  @@unique([observationKey, revisionOrdinal])
  @@unique([runId, observationKey])
  @@index([geographyId, runId])
}

/// Immutable snapshot membership allows refresh without inventing a new evidence revision.
model SecurityProjectionMember {
  runId          Int
  observationId  Int
  observationKey String
  run            SecurityProjectionRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  observation    SecurityObservation   @relation(fields: [observationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([runId, observationId])
  @@unique([runId, observationKey])
}

enum WatchSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum WatchRunStatus {
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  NO_EVIDENCE
  FAILED
  BUDGET_EXHAUSTED
  CANCELLED
}

// Dormant foundation. No relation to CountryFollow or Sand charging.
model WatchSubscription {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId         String
  countryCode       String
  status            WatchSubscriptionStatus @default(PAUSED)
  intervalSeconds   Int                     @default(3600)
  nextRunAt         DateTime
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastFailureCode   String?
  maxAttempts       Int                     @default(3)
  dailyRunLimit     Int                     @default(24)
  dailyAttemptLimit Int                     @default(48)
  evidenceLimit     Int                     @default(100)
  budgetDay         DateTime
  runsUsed          Int                     @default(0)
  attemptsUsed      Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  runs              WatchRun[]

  @@unique([userId, subjectId])
  @@index([status, nextRunAt])
}

model WatchRun {
  id             String            @id @default(cuid())
  subscriptionId String
  subscription   WatchSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  status         WatchRunStatus
  attempts       Int               @default(0)
  retryAt        DateTime?
  leaseUntil     DateTime?
  completedAt    DateTime?
  failureCode    String?
  createdAt      DateTime          @default(now())
  observation    WatchObservation?

  @@unique([subscriptionId, scheduledAt])
}

model WatchObservation {
  id         String   @id @default(cuid())
  runId      String   @unique
  run        WatchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  observedAt DateTime
  outcome    String
  // Bounded immutable copy of retained evidence; no fabricated change assessment.
  evidence   Json
  truncated  Boolean

  @@index([observedAt])
}

// CODEX J: additive authenticated Ask substrate. No anonymous persistence,
// wallet or balance. Stored model output is display-only, never evidence.
model AskThread {
  id             String        @id @default(uuid())
  /// ASK GUEST TRIAL R3 — exactly ONE owner: an account (userId) or a server-issued guest
  /// session (guestSessionId). Enforced by the CHECK constraint in the migration.
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  clientKey      String
  requestHash    String
  language       String
  returnPath     String?
  nextSequence   Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  turns          AskTurn[]

  @@unique([userId, clientKey])
  @@unique([guestSessionId, clientKey])
  @@index([userId, updatedAt])
  @@index([guestSessionId, updatedAt])
}

model AskTurn {
  id          String           @id @default(uuid())
  threadId    String
  thread      AskThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sequence    Int
  // Only the user's question is retained here; answer accessed by operation.
  question    String
  language    String
  operationId String           @unique
  operation   ComputeOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  bookmarks   AskBookmark[]

  @@unique([threadId, sequence])
}

/// PUBLIC BETA ASK CONTINUITY R1 — a reader's bookmark on one of their own Ask turns.
///
/// A RELATIONSHIP, NEVER A COPY. The question lives on `AskTurn.question` and the
/// answer is reached through that turn's `ComputeOperation` -> `StoredResult`.
/// Duplicating either here would create a second copy of canonical Ask content
/// that could drift from it, and would outlive `StoredResult.expiresAt` — a
/// bookmark must not become a way to keep an expired artifact readable.
///
/// OWNERSHIP IS THE ROW'S OWN FACT (`userId`), not an inference from the turn, so
/// a bookmark can be listed and deleted without first resolving the thread. The
/// turn's own ownership is still verified on create, through `AskThread.userId`.
///
/// CASCADE: deleting the account removes the bookmark; so does deleting the turn.
/// Neither leaves a row pointing at content that no longer exists.
model AskBookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  turnId    String
  turn      AskTurn  @relation(fields: [turnId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// One bookmark per reader per turn. The uniqueness is what makes "bookmark"
  /// idempotent rather than a counter.
  @@unique([userId, turnId])
  @@index([userId, createdAt])
}

model StoredResult {
  id               String             @id @default(uuid())
  /// ASK GUEST TRIAL R3 — exactly one owner (CHECK in the migration).
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId   String?
  guestSession     GuestSession?      @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  fingerprint      String
  evidenceRevision String
  // Immutable display artifact; NEVER consumed as a retrieval input.
  payload          Json
  createdAt        DateTime           @default(now())
  expiresAt        DateTime
  operations       ComputeOperation[]

  @@index([userId, fingerprint, expiresAt])
  @@index([guestSessionId, fingerprint, expiresAt])
}

model ComputeOperation {
  id                 String            @id @default(uuid())
  /// ASK GUEST TRIAL R3 — exactly one owner (CHECK in the migration).
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId     String?
  guestSession       GuestSession?     @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  clientKey          String
  requestHash        String
  kind               String
  computeClass       String
  fingerprint        String
  // Server-prepared contract, never caller context or prior model output.
  plan               Json
  quotedSand         Int               @default(0)
  ledgerEnabled      Boolean           @default(false)
  status             String            @default("QUOTED")
  quoteExpiresAt     DateTime
  acceptedAt         DateTime?
  leaseExpiresAt     DateTime?
  runToken           String?
  storedResultId     String?
  storedResult       StoredResult?     @relation(fields: [storedResultId], references: [id], onDelete: SetNull)
  storedResultReused Boolean           @default(false)
  failureCode        String?
  createdAt          DateTime          @default(now())
  completedAt        DateTime?
  turn               AskTurn?
  ledger             SandLedgerEntry[]

  guestSlot GuestSlot?

  @@unique([userId, clientKey])
  @@unique([guestSessionId, clientKey])
  @@index([userId, createdAt])
  @@index([guestSessionId, createdAt])
}

model SandLedgerEntry {
  id           String           @id @default(uuid())
  operationId  String
  operation    ComputeOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  entryType    String
  quotedSand   Int              @default(0)
  reservedSand Int              @default(0)
  finalSand    Int              @default(0)
  createdAt    DateTime         @default(now())

  // Cross-process protection in addition to transactional transitions.
  @@unique([operationId, entryType])
}

/// Reviewed projection over the shared retained byte store. No runtime writer.
/// Public payload.subjectType must exactly match Part XI; enforced by the SQL check and shared reader validator.
model EnergyObservation {
  id                       String            @id
  observationKey           String
  revision                 Int
  snapshotRetrievalId      String
  snapshotRetrieval        SnapshotRetrieval @relation(fields: [snapshotRetrievalId], references: [retrievalId], onDelete: Restrict)
  payload                  Json
  /// JSON Pointer to a publisher record, interpreted by energy-record-v1 only.
  evidencePointer          String
  parserVersion            String
  admission                String            @default("REFUSED")
  publicDisclosureApproved Boolean           @default(false)
  reviewedBy               String?
  reviewRef                String?

  @@unique([observationKey, revision])
}

/// MY INTELLIGENCE R1 — a story an authenticated user saved.
///
/// IDENTITY: articleRef = sha256(normalizeArticleUrl(url)), lowercase hex.
/// Never the provider's article id (a weak 32-bit hash) and never a title:
/// the canonical URL is the story's identity everywhere in the product.
/// providerArticleId is kept only as a non-authoritative lookup HINT.
///
/// METADATA ONLY. Every field below is resolved SERVER-SIDE from the
/// retained Article row at save time — a client-supplied title or source is
/// never trusted. There is deliberately no body, summary, excerpt, AI answer
/// or briefing column: this table cannot hold publisher text.
///
/// RETENTION: cascade-deleted with the User row, like every other
/// account-owned table.
model SavedStory {
  id                String   @id @default(uuid())
  userId            String
  /// sha256(normalizeArticleUrl(url)), 64 lowercase hex characters.
  articleRef        String
  /// normalizeArticleUrl(sourceUrl).
  canonicalUrl      String
  /// The URL exactly as retained on the Article row.
  sourceUrl         String
  /// Non-authoritative hint only. Never identity.
  providerArticleId String?
  title             String
  sourceName        String
  sourceDomain      String
  publishedAt       DateTime
  /// 'publisher' | 'observed' — copied from the Article row, never guessed.
  publishedAtBasis  String
  imageUrl          String?
  /// Governed ISO-3166 alpha-3 codes from the Article's country relations.
  countryCodes      String[]
  savedAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A repeat save is a database-level no-op.
  @@unique([userId, articleRef])
  @@index([userId, savedAt])
}

/// INTEREST + SELECTION HOOK R1 — explicit, reader-controlled My Intelligence
/// interests. One row per (user, interest). `interest` is a governed id from
/// MY_INTELLIGENCE_INTERESTS in shared/src/my-intelligence.ts, validated before
/// any write and enforced by a CHECK constraint: never free text, never
/// inferred, never AI-generated. Deleted with the account (cascade).
model UserIntelligenceInterest {
  id        String   @id @default(uuid())
  userId    String
  interest  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, interest])
  @@index([userId])
}

/// ════════════════════════════════════════════════════════════════════════════
/// ASK R2 CONSOLIDATED INTEGRATION R1 · GATE B — PUBLIC ASK OPERATIONAL CONTROLS
/// ════════════════════════════════════════════════════════════════════════════
/// Authority: F-ASK-R2-PUBLIC-ASK-OPERATIONAL-CONTROLS-CLOSURE-R1 (01 L-8..L-24, 02 §10,
/// 03 K-1..KS-14, 06). PostgreSQL is the only shared store this platform has (Redis /
/// cache-manager = 0), so the meter, the breaker and the switches live here. ADDITIVE:
/// five new tables, no existing table altered. No foreign key to any user or operation —
/// a scope string carries the identity, so an account deletion never blocks on the meter.

/// F 01 L-8 — the shared meter. One row per (scope, bucket). Reserved with ONE atomic
/// `INSERT … ON CONFLICT DO UPDATE SET units = units + EXCLUDED.units RETURNING units`,
/// so N replicas cannot interleave into an over-admit. Scopes: `global`, `acct:<id>`,
/// `ip:<prefix>`, `provider:<name>`, `conc:<…>` (concurrency, fixed bucket) and
/// `brk:<fail|ok>:<provider>` (breaker window counts).
model ComputeMeter {
  scope       String
  bucketStart DateTime @db.Timestamptz(6)
  units       BigInt   @default(0)

  @@id([scope, bucketStart])
}

/// F 01 L-9 — reserve before, settle after. `charges` lists the meter rows this
/// reservation incremented (and by how much); settle writes the actual back, and a reaper
/// releases a reservation that was never settled after `ASK_RESERVATION_TTL_S`.
model ComputeReservation {
  id        String    @id @default(uuid())
  charges   Json
  units     BigInt
  expiresAt DateTime  @db.Timestamptz(6)
  settledAt DateTime? @db.Timestamptz(6)
  outcome   String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([settledAt, expiresAt])
}

/// F 02 §10 — one breaker per provider (B-1), shared across replicas (B-2).
model CircuitBreakerState {
  provider       String    @id
  state          String    @default("CLOSED")
  openUntil      DateTime? @db.Timestamptz(6)
  cooldownS      Int       @default(30)
  trialsInFlight Int       @default(0)
  trialSuccesses Int       @default(0)
  updatedAt      DateTime  @default(now()) @db.Timestamptz(6)
}

/// F 03 — operational switches (K-1 `ASK_PUBLIC_COMPUTE_ENABLED`, K-2 `ASK_R2_ENABLED`).
/// ON only when the deployment variable is the literal 'true' AND this row enables it;
/// unreadable ⇒ OFF (KS-5). Re-enabling is a named decision by a named person (KS-9).
model OperationalSwitch {
  name    String   @id
  enabled Boolean  @default(false)
  setBy   String
  setAt   DateTime @default(now()) @db.Timestamptz(6)
  reason  String?
}

/// F 03 KS-9 — every change, with the actor. Append-only.
model OperationalSwitchAudit {
  id      String   @id @default(uuid())
  name    String
  enabled Boolean
  setBy   String
  reason  String?
  setAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([name, setAt])
}

/// ════════════════════════════════════════════════════════════════════════════
/// ADMIN ASK INTELLIGENCE OBSERVABILITY R1 — WHAT READERS NEEDED, NOT WHAT THEY TYPED
/// ════════════════════════════════════════════════════════════════════════════
///
/// One row per Ask R2 execution attempt. Every column is a value the router or the
/// executor ALREADY derived while doing its work: no second classifier runs for
/// analytics, and nothing here is inferred from text at read time.
///
/// THERE IS NO COLUMN A QUESTION COULD OCCUPY, AND THAT IS THE POINT. No question, no
/// prompt, no reader term, no stated period, no matched place text, no article body, no
/// provider response and no account reference. `askObservation.privacy.spec.ts` asserts
/// that absence over THIS BLOCK, so a future edit that adds such a column fails a test
/// rather than merely disagreeing with a comment. The reader's own words stay in
/// `AskTurn.question`, which this model does not reference and the Admin surface never
/// reads.
///
/// NO ACCOUNT LINKAGE. `operationId` identifies the OPERATION, and it is unique, so one
/// explicit Ask can produce at most one observation — a database constraint rather than
/// the writer's discipline. `ComputeOperation.userId` is never selected by anything that
/// serves this data, and there is no userId column here to join on by accident.
///
/// NO MONETARY FIGURE. No governed price source exists, so there is no cost column and
/// no code that could compute one.
///
/// NO DEVICE CLASS. Deriving one needs a user-agent, which no telemetry in this platform
/// reads. The field is absent rather than present and permanently null.
model AskObservation {
  id             String   @id @default(uuid())
  /// The Ask operation this observes. UNIQUE — one Ask, at most one observation.
  operationId    String   @unique
  occurredAt     DateTime @default(now()) @db.Timestamptz(6)
  /// The observation contract this row was written under, so a later shape is readable.
  schemaVersion  String
  /// 'ASK_R2' today. The vocabulary also declares the legacy path, which has no emitter.
  routePath      String
  adapterVersion String

  questionClass         String
  queryIntent           String
  terminalState         String
  answerState           String
  /// The §7 derivation's own diagnostic code (`AnswerStateDecision.basis`).
  answerBasis           String
  clarificationRequired Boolean  @default(false)
  capabilityUnavailable Boolean  @default(false)
  /// Frozen C refusal / disclosure / clarification CODES. Codes only, never prose.
  refusalCodes          String[]
  disclosureCodes       String[]
  clarificationCodes    String[]

  /// The language the reader ASKED IN, as the router classified it. Not a location.
  requestLanguage        String
  questionLanguage       String?
  languageClassification String
  normalizationStatus    String

  /// GEOGRAPHY OF THE QUESTION'S SCOPE — never audience location. These are the places
  /// the question is ABOUT, as governed codes the resolver produced. A value outside the
  /// governed vocabulary is DROPPED by the writer and counted, so free text cannot arrive
  /// here even if a future producer emits it.
  geographyPresent      Boolean  @default(false)
  geographyCodes        String[]
  geographySources      String[]
  geographyPrecision    String
  geographyCodesDropped Int      @default(0)
  scopedBy              String

  /// The eight landed analytical domains. A bounded vocabulary, not reader words.
  domains             String[]
  domainCount         Int      @default(0)
  /// PRESENCE ONLY. The reader's topic terms are the reader's words and are not stored.
  topicPresent        Boolean  @default(false)
  temporalRequirement String
  /// PRESENCE ONLY. A stated period is text at the reader's own precision; not stored.
  statedPeriodPresent Boolean  @default(false)

  evidenceRolesRequested String[]
  evidenceRolesObtained  String[]
  evidenceRolesMissing   String[]
  /// Admitted reporting items. Null when execution never reached retrieval.
  reportingItemCount     Int?
  /// INTELLIGENCE BINDING R1 — governed contributor ids considered / used / degraded, and
  /// the governed observations used. Ids and a count only — never content.
  contributorsConsidered String[] @default([])
  contributorsUsed       String[] @default([])
  contributorsDegraded   String[] @default([])
  contributorItemCount   Int?

  computeClass         String
  providerId           String?
  providerCallCount    Int     @default(0)
  modelInvocationCount Int     @default(0)
  aiExecuted           Boolean @default(false)
  /// The circuit breaker's own verdict for this attempt: SUCCESS, FAILURE, TIMEOUT or
  /// REFUSAL. Null when the breaker was never consulted, which is the zero-compute path —
  /// and "not consulted" is not "succeeded".
  breakerOutcome       String?
  /// NULLABLE ON PURPOSE. Populated only when the provider reported usage. `tokensMeasured`
  /// travels with them so an absent measurement is never averaged or rendered as zero.
  promptTokens         Int?
  completionTokens     Int?
  tokensMeasured       Boolean @default(false)
  latencyMs            Int?

  failureCode   String?
  /// 'ANONYMOUS' or 'VERIFIED_ANALYSIS_USER' — the router's identity AXIS, not an account.
  identityState String

  /// The two-key operational switches AS READ FOR THIS ASK. Null means the switch was
  /// never consulted because the answer needed no compute — not that it was off.
  askR2Enabled            Boolean?
  askPublicComputeEnabled Boolean?

  @@index([occurredAt])
  @@index([questionClass, occurredAt])
  @@index([answerState, occurredAt])
  @@index([routePath, occurredAt])
}

/// ADMIN ASK INTELLIGENCE OBSERVABILITY R1 — BOUNDED COUNTERS FOR ATTEMPTS THAT NEVER
/// BECAME AN EXECUTION.
///
/// A signed-out Ask attempt is refused by RequireAuthGuard before any operation exists,
/// so it has no `AskObservation` and never will. It is still a Product fact worth having.
/// It is counted rather than rowed BECAUSE it is unauthenticated: one row per attempt on
/// a route anyone can call is unbounded write amplification, which is exactly the failure
/// the telemetry module already refuses. Cardinality here is (events × hours) and nothing
/// a caller supplies enters the key.
model AskAccessCounter {
  event       String
  bucketStart DateTime @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([event, bucketStart])
}

/// ════════════════════════════════════════════════════════════════════════════
/// ASK GUEST TRIAL + FIRST-ANSWER R3 — THE FIRST-VISIT GUEST, A REAL, SEPARATE OWNER
/// ════════════════════════════════════════════════════════════════════════════
///
/// A server-issued guest session: never a User, never shared. The raw token lives only in
/// the visitor's HttpOnly cookie; this row keeps its SHA-256. `expiresAt` is an ABSOLUTE
/// lifetime from creation (never extended by activity). No IP address, fingerprint or
/// account identifier is stored here.
model GuestSession {
  id              String    @id @default(uuid())
  tokenHash       String    @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime  @db.Timestamptz(6)
  lastSeenAt      DateTime  @default(now()) @db.Timestamptz(6)
  /// ACTIVE · CLAIMED (conversation moved to an account; the token is dead) · REVOKED
  status          String    @default("ACTIVE")
  claimedByUserId String?
  claimedAt       DateTime? @db.Timestamptz(6)

  threads    AskThread[]
  operations ComputeOperation[]
  results    StoredResult[]
  claims     GuestClaim[]
  slots      GuestSlot[]

  @@index([expiresAt])
  @@index([status, expiresAt])
}

/// One visible guest-answer slot per eligible execution — the TRIAL ENTITLEMENT ledger.
/// Resource usage is metered separately (ComputeMeter). RESERVED before any research work;
/// COMMITTED exactly once with a durable substantive result; RELEASED on a no-count outcome.
/// Keyed by the operation, so moving the conversation to an account never loses it.
model GuestSlot {
  operationId    String           @id
  operation      ComputeOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  guestSessionId String
  guestSession   GuestSession     @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  /// RESERVED · COMMITTED · RELEASED
  state          String           @default("RESERVED")
  /// For RELEASED: NO_ANSWER (work ran, nothing substantive) · FAILED (work may have run) ·
  /// REFUSED (a control refused before any spend).
  releaseReason  String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  settledAt      DateTime?        @db.Timestamptz(6)

  @@index([guestSessionId, state])
  @@index([state, createdAt])
}

/// A one-time claim that binds ONE guest conversation to the next Google sign-in from the
/// same browser. Server-side only; its id travels inside the HMAC-signed OAuth flow cookie,
/// never in a URL. PENDING → CONSUMED exactly once (or EXPIRED).
model GuestClaim {
  id               String       @id @default(uuid())
  guestSessionId   String
  guestSession     GuestSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  threadId         String
  /// PENDING · CONSUMED · EXPIRED
  status           String       @default("PENDING")
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime     @db.Timestamptz(6)
  consumedAt       DateTime?    @db.Timestamptz(6)
  consumedByUserId String?

  @@index([guestSessionId, status])
  @@index([consumedByUserId, consumedAt])
  @@index([expiresAt])
}

/// ════════════════════════════════════════════════════════════════════════════
/// HOME, DISCUSSIONS, ALERTS & PAID R1 · STAGE B — CANONICAL STORY IDENTITY
/// ════════════════════════════════════════════════════════════════════════════
///
/// `articleRef = sha256(normalizeArticleUrl(url))` stays the immutable ARTICLE identity
/// (SavedStory, selection, Ask context keep it unchanged). A Story is a CLUSTER of articles
/// with an opaque, server-issued id — never derived from a URL. Membership is one row per
/// article (an article belongs to exactly one current story). Backfill is conservative: it
/// joins two articles only when the 6ba220f identity ladder (`isSameStory`) PROVES sameness;
/// everything else stays a singleton. A merge keeps the survivor and turns the other story
/// into an ALIAS (status MERGED, mergedIntoId); a split creates a new story. Every identity
/// change is an audit row. Nothing here rewrites an article or a saved story.
model Story {
  id                   String    @id @default(uuid())
  /// 'ACTIVE' | 'MERGED' (CHECK in the migration). A MERGED story is an alias of mergedIntoId.
  status               String    @default("ACTIVE")
  mergedIntoId         String?
  mergedInto           Story?    @relation("StoryAlias", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  aliases              Story[]   @relation("StoryAlias")
  /// Material-evidence version (>= 1). Increments only when a NEW source host joins the
  /// story or a merge brings new evidence; another article from a host already present
  /// adds a source without a version. The Alert dedup key is (alert, briefVersion).
  briefVersion         Int       @default(1)
  briefUpdatedAt       DateTime? @db.Timestamptz(6)
  /// Discussion lock (moderation). Reading stays open; writing is refused while locked.
  discussionLockedAt   DateTime? @db.Timestamptz(6)
  discussionLockReason String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  articles StoryArticle[]
  comments StoryComment[]
  alerts   StoryAlert[]

  @@index([mergedIntoId])
}

/// One article's membership. `articleRef` is the governed identity (unique: one current
/// story per article); `articleUrl` is the retained URL it was verified against.
model StoryArticle {
  id              String   @id @default(uuid())
  storyId         String
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Restrict)
  articleRef      String   @unique
  articleUrl      String
  sourceHost      String
  addedAt         DateTime @default(now()) @db.Timestamptz(6)
  /// The story this article was moved FROM by a merge/split (continuity), if any.
  previousStoryId String?

  @@index([storyId])
}

/// Audit trail of every identity change: CREATE, JOIN, MERGE, SPLIT, VERSION.
/// `actorId` is a plain id (no User relation): deleting an operator never erases the audit.
model StoryIdentityEvent {
  id           String   @id @default(uuid())
  kind         String
  storyId      String
  otherStoryId String?
  articleRefs  String[]
  briefVersion Int?
  actorId      String?
  reason       String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([storyId, createdAt])
}

/// ════════════════════════════════════════════════════════════════════════════
/// STAGE B — DISCUSSION. Never evidence: no Ask, retrieval, prompt or source path reads it.
/// ════════════════════════════════════════════════════════════════════════════
model StoryComment {
  id               String         @id @default(uuid())
  /// The story the comment was written on. After a merge it is read through the survivor.
  storyId          String
  story            Story          @relation(fields: [storyId], references: [id], onDelete: Restrict)
  /// Author. Account deletion removes the author's comments (privacy); replies by others
  /// survive with parentId set to NULL.
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           StoryComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies          StoryComment[] @relation("CommentReplies")
  body             String
  /// 'VISIBLE' | 'HIDDEN' | 'REMOVED' (moderation) | 'DELETED' (by its author). CHECK below.
  state            String         @default("VISIBLE")
  /// The brief version and article the reader was looking at (continuity, never identity).
  briefVersion     Int
  originArticleRef String?
  idempotencyKey   String
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  editedAt         DateTime?      @db.Timestamptz(6)
  deletedAt        DateTime?      @db.Timestamptz(6)

  reports StoryCommentReport[]

  @@unique([userId, idempotencyKey])
  @@index([storyId, createdAt])
  @@index([parentId])
}

model StoryCommentReport {
  id        String       @id @default(uuid())
  commentId String
  comment   StoryComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([commentId, userId])
}

/// Moderation audit (hide / remove / restore / lock / unlock). Plain actor id: survives
/// the operator's account; a comment's removal never erases the audit.
model StoryModerationAction {
  id        String   @id @default(uuid())
  action    String
  storyId   String
  commentId String?
  actorId   String
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([storyId, createdAt])
}

/// ════════════════════════════════════════════════════════════════════════════
/// STAGE B — ALERTS (in-app only). NOT Follow, NOT the dormant Watch. No delivery
/// channel, address, token or subscription is stored anywhere here.
/// ════════════════════════════════════════════════════════════════════════════
model StoryAlert {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The canonical subject the reader chose (resolved through aliases on read).
  storyId             String
  story               Story     @relation(fields: [storyId], references: [id], onDelete: Restrict)
  /// The article the reader created the alert FROM — immutable governed identity
  /// (sha256(normalizeArticleUrl(url))). An editor split moves the alert with this article.
  originArticleRef    String
  /// 'ACTIVE' | 'PAUSED' | 'REMOVED' (CHECK below). REMOVED keeps the row (undo).
  status              String    @default("ACTIVE")
  muted               Boolean   @default(false)
  createdBriefVersion Int
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  removedAt           DateTime? @db.Timestamptz(6)

  events StoryAlertEvent[]

  @@unique([userId, storyId])
  @@index([userId, status])
  @@index([storyId, status])
}

/// One meaningful change for one alert. Dedup = (alertId, briefVersion): a repeated
/// detection of the same version is the same event.
model StoryAlertEvent {
  id           String     @id @default(uuid())
  alertId      String
  alert        StoryAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  storyId      String
  briefVersion Int
  kind         String
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  readAt       DateTime?  @db.Timestamptz(6)

  @@unique([alertId, briefVersion])
  @@index([alertId, readAt])
}

/// The Replies tab's read cursor (replies to the reader's own comments). One row per reader.
model UserInboxCursor {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repliesSeenAt DateTime @db.Timestamptz(6)
}
