generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id           String   @id
  title        String
  summary      String
  url          String   @unique
  imageUrl     String?
  sourceId     String
  sourceName   String
  sourcesCount Int      @default(1)
  category     String
  publishedAt  DateTime
  fetchedAt    DateTime @default(now())

  countryCode String?
  countryName String?

  relevanceScore  Int?
  confidenceScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countries ArticleCountry[]

  @@index([publishedAt])
  @@index([sourceId])
  @@index([category])
  @@index([countryCode])
}

model ArticleCountry {
  id             String   @id @default(cuid())
  articleId      String
  countryCode    String
  countryName    String
  relevanceScore Int
  isRelevant     Boolean  @default(false)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, countryCode])
  @@index([countryCode])
  @@index([relevanceScore])
}