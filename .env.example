# ---------------------------------------------------------------------------
# GlobalNews AI - Root Environment Variables (example)
#
# This root file is used by `docker-compose.yml` to configure ports shared
# across services. Each workspace also has its own .env.example:
#   - frontend/.env.example  -> copy to frontend/.env.local
#   - backend/.env.example   -> copy to backend/.env
#
# Copy this file to `.env` at the project root before running
# `docker compose up`.
# ---------------------------------------------------------------------------

# Ports exposed on the host machine
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Environment mode
NODE_ENV=development

# GNews API key (https://gnews.io), passed through to the backend
# container by docker-compose.yml. Leave unset to run the news module
# in mock mode. Never commit a real key.
GNEWS_API_KEY=replace_with_your_gnews_key

# OpenAI API key, passed through to the backend container only (never
# the frontend). Leave unset to run the analysis module in mock mode.
# Never commit a real key.
OPENAI_API_KEY=replace_with_your_openai_key
OPENAI_MODEL=gpt-4o-mini
