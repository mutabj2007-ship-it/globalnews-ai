# ---------------------------------------------------------------------------
# GlobalNews AI - Root Environment Variables (example)
#
# This root file is used by `docker-compose.yml` to configure ports shared
# across services. Each workspace also has its own .env.example:
# - frontend/.env.example  -> copy to frontend/.env.local
# - backend/.env.example   -> copy to backend/.env
#
# Copy this file to `.env` at the project root before running
# `docker compose up`.
# ---------------------------------------------------------------------------

# Ports exposed on the host machine
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ---------------------------------------------------------------------------
# Application environment
# ---------------------------------------------------------------------------

# Use "development" for local development.
# NODE_ENV=production always forces production-safe AI execution behavior.
#
# REQUIRED. docker-compose.yml supplies NO default for this variable: if it is
# unset or empty, `docker compose` refuses to render the file rather than
# silently substituting "development". That default previously disarmed every
# fail-closed production guard at once (CORS origin, GNews key requirement,
# OpenAI key requirement, and the Secure attribute on every session cookie),
# and it silently overrode the production images own ENV NODE_ENV=production.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database credentials (docker-compose.yml)
# ---------------------------------------------------------------------------

# Credentials for the Compose `postgres` service. The backend DATABASE_URL
# below is assembled from these same three values, so the database and the
# connection string can never drift apart.
#
# POSTGRES_PASSWORD is REQUIRED. docker-compose.yml supplies NO default for it:
# if it is unset or empty, `docker compose` refuses to render the file rather
# than substituting a placeholder credential that could reach a real
# deployment. POSTGRES_USER and POSTGRES_DB keep their existing non-secret
# development defaults.
#
# Never commit a real password - the value below is a placeholder only.
POSTGRES_USER=globalnews_ai_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=globalnews_ai

# ---------------------------------------------------------------------------
# Database (Milestone #53)
# ---------------------------------------------------------------------------

# PostgreSQL connection string for backend/src/database/prisma.service.ts.
#
# REQUIRED for the backend to start at all, in every environment
# (development and production alike) — PrismaService's constructor
# throws immediately if this is missing, before any HTTP request is
# ever handled. This is a genuine startup dependency, not an optional
# convenience: NewsService (via ArticlePersistenceService) and the
# health check both depend on it.
#
# A missing DATABASE_URL is the most common reason a fresh checkout
# fails to start — set this before running `npm run dev:backend` or
# `npm run start:backend`.
#
# Never commit a real connection string (username/password included).
# The example below is a placeholder only.
DATABASE_URL=postgresql://globalnews_ai_user:change_me@localhost:5432/globalnews_ai?schema=public

# ---------------------------------------------------------------------------
# Backend security (Milestone #34)
# ---------------------------------------------------------------------------

# The exact origin (scheme + host + port) allowed to make CORS requests
# to the backend.
#
# Development (NODE_ENV != production):
#   May be left unset. The backend falls back to
#   http://localhost:3000 (this repo's default frontend dev server).
#
# Production (NODE_ENV=production):
#   A real, non-blank origin is required, e.g.
#   https://app.globalnews.example
#   A missing, empty, or whitespace-only value causes backend startup
#   to fail closed rather than silently allowing http://localhost:3000
#   in production. No network request is made to verify this value.
#
# CORS is a browser same-origin convenience, not an authentication or
# API security boundary — see rate limiting below for abuse control.
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend runtime configuration (Milestone #60)
# ---------------------------------------------------------------------------

# The frontend's own base URL for the backend API — the counterpart to
# FRONTEND_ORIGIN above (that one tells the backend which frontend origin
# to trust; this one tells the frontend which backend to call).
#
# Development: http://localhost:4000 (this repo's default backend dev
# server — matches BACKEND_PORT above).
#
# Production: must be set to the real, deployed backend URL, e.g.
#   https://api.globalnews.example
#
# IMPORTANT — because this variable name starts with NEXT_PUBLIC_,
# Next.js inlines its value directly into the built frontend JavaScript
# bundle at BUILD TIME, not read at runtime like a typical server-side
# environment variable. If it is missing or wrong when the production
# frontend is built, every visitor's browser will silently try to reach
# the wrong backend (or localhost) — there is no way to fix this after
# the build without rebuilding the frontend. Set it correctly before
# running the production frontend build, not just before starting it.
#
# This is a plain base URL, never a secret — do not place any API key,
# token, or credential in this variable.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The frontend's SERVER-SIDE base URL for the backend API - the counterpart to
# NEXT_PUBLIC_API_URL above.
#
# NEXT_PUBLIC_API_URL is the address a visitor's BROWSER uses. This one is the
# address the Next.js SERVER runtime uses: Server Components and route handlers,
# which execute inside the frontend container itself. In a containerised
# deployment those are not the same host - inside the frontend container
# `localhost` is the frontend, not the backend, so a server-side request to the
# browser's public URL fails at the TCP level.
#
# RUNTIME ONLY. Deliberately NOT named NEXT_PUBLIC_* and deliberately NOT passed
# as a Docker build arg, so Next.js can never inline it into the browser bundle.
# Server-side code reads it from the container environment at request time;
# browser-delivered JavaScript never sees it and must never contain it.
#
# Docker Compose default: http://backend:4000 - the Compose service hostname,
# resolvable only on the Compose network. Outside Docker (plain `npm run dev`),
# leave it unset: resolution falls back to NEXT_PUBLIC_API_URL and then to
# http://localhost:4000, exactly as before.
#
# This is a plain internal base URL, never a secret - do not place any API key,
# token, or credential in this variable.
SERVER_INTERNAL_API_URL=http://backend:4000

# ---------------------------------------------------------------------------
# Bounded proxy trust (B-1)
# ---------------------------------------------------------------------------

# Tells the backend how many proxies - or which ones - sit in front of it, so it
# can resolve the real client address instead of the proxy's.
#
# This is a rate-limiting correctness setting, not a convenience. The request
# throttle identifies a caller by its IP. Behind a reverse proxy, CDN or load
# balancer, every visitor arrives with the PROXY's address, so the entire public
# shares one bucket per endpoint - including the deliberately strict 5-per-minute
# limit on POST /analysis/news, which becomes five per minute for the whole site
# rather than five per person. The limit is not wrong; without this, the key is.
#
# DEFAULT false - unchanged behaviour. The direct socket peer is the client and
# no X-Forwarded-For header is believed. Leave it unset for local development and
# for any deployment genuinely reached without a proxy. docker-compose.yml
# supplies false, so an unset value can never widen trust.
#
# PREFERRED PRODUCTION FORM - an IP/CIDR allowlist. Only these peers may supply a
# client address; anyone else is treated as the client themselves. This form
# carries no preconditions:
#     TRUST_PROXY=10.0.0.0/8
#     TRUST_PROXY=loopback,172.16.0.0/12
# Accepts IPv4, IPv6, CIDR ranges, and the names loopback / linklocal /
# uniquelocal.
#
# PERMITTED ALTERNATIVE - a proxy count, 1 to 10:
#     TRUST_PROXY=1
# Use this ONLY where ingress topology guarantees this backend cannot be reached
# except through those proxies. A hop count trusts whichever peer connects, so if
# the origin is directly reachable, an attacker can connect to it with a forged
# X-Forwarded-For, be counted as the trusted hop, and have the forged value
# accepted as their identity. Too high a count re-opens that; too low collapses
# every visitor back onto the proxy's address. There is no safe default, which is
# why an unrecognised value refuses to start rather than guessing.
#
# REJECTED - "true", "yes", "on", "*". The application refuses to start on any of
# them. They would trust the entire forwarded chain, letting any client mint a
# fresh rate-limit identity on every request and bypass throttling completely,
# including the AI cost control. That is worse than the problem this setting
# solves, so it is unreachable by configuration rather than merely discouraged.
#
# NOT A SECRET - this is a topology description. Never place a key, token or
# credential in it.
#
# One operational consequence worth knowing before enabling: request logs will
# begin recording real client addresses rather than the proxy's. That is more
# useful for correlation, and it is also more personal data.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# News provider
# ---------------------------------------------------------------------------

# GNews API key, passed through to the backend container.
# Leave unset during local development to allow the news module to use
# its configured mock behavior.
# Never commit a real API key.
#
# Milestone #33: NODE_ENV=production always requires a real, non-blank
# GNEWS_API_KEY. A missing, empty, or whitespace-only value causes
# backend startup to fail closed rather than silently serving mock
# news as if it were live reporting.
GNEWS_API_KEY=replace_with_your_gnews_key

# ---------------------------------------------------------------------------
# R4 / G-ALPHA-1 — GDELT DOC 2.0 fallback NEWS provider
# ---------------------------------------------------------------------------
# THIS IS NOT THE SAME PROVIDER AS GDELT_ENABLED BELOW. That one is the GEO
# signal provider in the signals module. This one is the DOC 2.0 search
# provider in the news module: the FALLBACK-tier provider consulted when the
# primary (GNews) yields no usable articles for a request.
#
# GDELT DOC 2.0 needs no API key, so activation is a plain toggle.
#
# FAIL-CLOSED, AND STRICTLY LITERAL. Only the exact string "true" — trimmed and
# case-insensitive — switches this provider on. "1", "yes", "on", "TRUE!",
# an empty value, a whitespace-only value and an unset variable ALL mean
# DISABLED. See isGdeltDocEnabled() in
# backend/src/modules/news/providers/provider.tokens.ts.
#
# DEFAULT OFF IS DELIBERATE, and it has a consequence worth stating plainly:
# while this is unset, the news fallback tier is EMPTY, and retrieval is
# single-provider. GET /news/providers/health reports the provider as
# "enabled": false with the message
# 'GDELT_DOC_ENABLED is not set to "true". This provider is switched off.'
# — check there rather than guessing which state a deployment is in.
GDELT_DOC_ENABLED=false

# ---------------------------------------------------------------------------
# PUBLISHER FEEDS — recovered from canonical C55, FALLBACK tier
# ---------------------------------------------------------------------------
# A CURATED registry of named publishers fetched over RSS. NOT a generic
# crawler: the registry in
# backend/src/modules/news/providers/feed-source-registry.ts is the allowlist,
# and every entry was fetched and verified on 2026-08-31 with the capture
# recorded in its own provenanceNote.
#
#   LOCAL JOURNALISM   feed:ktpress-rw       KT Press                  (RW)
#                      feed:taarifa-rw       Taarifa Rwanda            (RW)
#                      feed:standardmedia-ke The Standard              (KE)
#                      feed:wp-pl            Wirtualna Polska          (PL)
#   OFFICIAL / PUBLIC  feed:cbk-ke           Central Bank of Kenya     (KE)
#                      feed:gus-pl           Statistics Poland         (PL)
#
# TWO INDEPENDENT SWITCHES, AND BOTH DEFAULT OFF.
#
#   RSS_FEEDS_ENABLED  the lane's master switch. FAIL-CLOSED AND STRICTLY
#                      LITERAL: only the exact string "true" — trimmed,
#                      case-insensitive — switches the provider on. "1", "yes",
#                      "on", blank and unset ALL mean DISABLED.
#   RSS_FEED_SOURCES   which publishers may be fetched, as an explicit
#                      comma/space separated allowlist of sourceIds. There is
#                      deliberately NO wildcard: a future registry entry can
#                      never activate itself because someone appended to an
#                      array. Unset or blank means "use the shipped `enabled`
#                      flags", which are ALL false.
#
# So the lane needs BOTH switches to fetch anything, and landing the code
# activates nothing. An id that matches no registry entry activates nothing and
# is reported through GET /news/providers/health rather than failing silently.
#
# Example, once the Product Owner rules on activation:
#   RSS_FEEDS_ENABLED=true
#   RSS_FEED_SOURCES=feed:ktpress-rw,feed:taarifa-rw
RSS_FEEDS_ENABLED=false
RSS_FEED_SOURCES=

# ---------------------------------------------------------------------------
# M64.2 — GDELT GEO 2.0 signal provider
# ---------------------------------------------------------------------------
# GDELT GEO 2.0 is a public API and does not require an API key (confirmed
# during the M64.2 audit). Configuration exists so nothing is hardcoded
# throughout service code, per the same convention GNews already follows.
GDELT_ENABLED=true
GDELT_GEO_API_BASE_URL=https://api.gdeltproject.org/api/v2/geo/geo
GDELT_REQUEST_TIMEOUT_MS=8000
GDELT_DEFAULT_LIMIT=25

# ---------------------------------------------------------------------------
# M64.4 — Event Registry signal provider
# ---------------------------------------------------------------------------
# Unlike GDELT, Event Registry requires a real API key for meaningful use
# (confirmed from the official OpenAPI spec's own securitySchemes block).
# Leave EVENT_REGISTRY_ENABLED=false (or leave the key blank) during local
# development — the provider reports itself honestly disabled/unconfigured
# and makes zero network calls. Never commit a real API key.
EVENT_REGISTRY_ENABLED=false
EVENT_REGISTRY_API_KEY=replace_with_your_event_registry_key
EVENT_REGISTRY_BASE_URL=https://eventregistry.org/api/v1/event/getEvents
EVENT_REGISTRY_REQUEST_TIMEOUT_MS=8000
EVENT_REGISTRY_DEFAULT_LIMIT=25

# ---------------------------------------------------------------------------
# AI analysis provider
# ---------------------------------------------------------------------------

# Explicit AI execution mode.
#
# development:
#   Local development may use mock analysis when no OpenAI key is available.
#
# production:
#   Production AI is expected. A missing or blank OPENAI_API_KEY causes
#   backend startup to fail closed.
#
# IMPORTANT:
# NODE_ENV=production always forces production AI mode even if this value
# is omitted or incorrectly set to "development".
AI_EXECUTION_MODE=development

# OpenAI API key.
# This is passed only to the backend, never to the frontend.
#
# Local development:
#   The key may be omitted when mock analysis is intended.
#
# Production:
#   A valid non-blank key is required or backend startup fails closed.
#
# Never commit a real API key.
OPENAI_API_KEY=replace_with_your_openai_key

# OpenAI model used by the analysis provider.
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Analysis limits and resilience
# ---------------------------------------------------------------------------

# Maximum number of retrieved articles sent to the AI provider.
ANALYSIS_MAX_ARTICLES=8

# Maximum amount of article title/summary content sent per article.
ANALYSIS_MAX_ARTICLE_CHARS=1200

# Timeout for each AI provider attempt, in milliseconds.
ANALYSIS_TIMEOUT_MS=20000

# Successful analysis cache lifetime, in seconds.
# Set to 0 only if caching is intentionally disabled.
ANALYSIS_CACHE_TTL_SECONDS=300

# Number of retry attempts AFTER the initial OpenAI request.
# 0 disables retries.
# Default: 2.
ANALYSIS_RETRY_ATTEMPTS=2

# Base delay, in milliseconds, for exponential retry backoff.
# Default: 300 ms.
ANALYSIS_RETRY_BASE_DELAY_MS=300

# Milestone #45 — hard upper bound on OpenAI completion length, in
# tokens. Sent as max_completion_tokens (not the deprecated max_tokens)
# on every OpenAI request. Bounds worst-case completion cost regardless
# of how verbose a model response might otherwise be.
# Default: 2000.
ANALYSIS_MAX_COMPLETION_TOKENS=2000

# ---------------------------------------------------------------------------
# Milestone #57 -- Optional Accounts (Google OAuth/OIDC)
# ---------------------------------------------------------------------------

# Google OAuth 2.0 / OIDC client credentials, used ONLY by the optional
# sign-in flow (GET /auth/google, GET /auth/google/callback). Accounts
# are entirely optional -- every existing browse/search/map/analysis
# capability works with these values absent. They are required only for
# a real user to complete Sign In successfully.
#
# Register an OAuth 2.0 Client ID (Web application type) in Google Cloud
# Console, with an authorized redirect URI of:
#   http://localhost:4000/auth/google/callback   (development)
#   ${PUBLIC_BACKEND_ORIGIN}/auth/google/callback  (production -- see below)
#
# B-2 repair -- that production URI is no longer guessed from the incoming
# request. It is built from PUBLIC_BACKEND_ORIGIN, documented immediately
# below this block. The two must match BYTE FOR BYTE.
#
# Never commit real values -- the examples below are placeholders only.
OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=change_me

# Milestone #57 security correction -- HMAC-SHA256 secret used to
# authenticate the ephemeral OAuth flow-state cookie (gna_oauth_flow)
# before its state/codeVerifier/nonce fields are trusted during the
# callback. Deliberately SEPARATE from OAUTH_CLIENT_SECRET -- that
# value is Google's own credential; this one only ever needs to
# authenticate a value this backend generated for itself minutes
# earlier. Never commit a real value -- generate a long random string
# for each environment (e.g. openssl rand -base64 32).
OAUTH_FLOW_SECRET=change_me

# ---------------------------------------------------------------------------
# B-2 repair -- PUBLIC_BACKEND_ORIGIN (public OAuth callback identity)
# ---------------------------------------------------------------------------

# WHAT IT IS
# The origin at which a BROWSER reaches this backend: scheme + host, plus a
# port only if it is not the scheme's default. It is NOT the internal container
# address (http://backend:4000) and NOT the frontend origin (FRONTEND_ORIGIN
# above, which is a different thing for a different purpose).
#
# WHY IT EXISTS
# The OAuth redirect URI used to be derived from the incoming request:
#   `${request.protocol}://${request.get('host')}/auth/google/callback`
# `req.protocol` reflects X-Forwarded-Proto only when Express's `trust proxy`
# is truthy, and TRUST_PROXY ships as false. Behind a TLS-terminating proxy --
# which is every public HTTPS deployment of this application -- that produced
# `http://...` while the URI registered with Google is `https://...`. Google
# compares redirect_uri byte for byte, answered redirect_uri_mismatch, and
# sign-in was impossible. Because accounts gate history, support and the whole
# admin platform, that one mismatch took all of them down, and nothing detected
# it at startup.
#
# This variable also removes the Host header from the decision. Host is
# supplied by the caller and had no business deciding where Google sends a user.
#
# FORM
#   An absolute origin. No path, no query, no fragment, no credentials.
#     PUBLIC_BACKEND_ORIGIN=https://api.globalnews.ai
#   A trailing slash is normalised away rather than rejected. Host case and a
#   redundant default port (:443 on https) are normalised too, because Google
#   compares byte for byte and a deployment should not have to type it
#   perfectly to work.
#
# PRODUCTION -- MANDATORY, AND https ONLY.
#   Missing, empty, whitespace-only, malformed, or http:// all REFUSE TO START.
#   http is refused deliberately: accepting it would let the exact defect this
#   variable removes from the code return through configuration instead.
#
# DEVELOPMENT -- OPTIONAL.
#   Unset falls back to http://localhost:4000, which matches the development
#   redirect URI registered in Google Cloud Console. The fallback is a FIXED
#   STRING and is deliberately NOT derived from PORT: docker-compose maps
#   ${BACKEND_PORT:-4000}:4000 while setting PORT=4000 inside the container, so
#   PORT is the listening port and can differ from the port a browser reaches.
#   If you move the published port, set this variable explicitly.
#   A malformed value throws in development too -- a silently ignored setting
#   looks configured and is not.
#
# MUST MATCH the Authorized redirect URI in Google Cloud Console:
#     ${PUBLIC_BACKEND_ORIGIN}/auth/google/callback
#
# RELATIONSHIP TO TRUST_PROXY: none, and that is the improvement. TRUST_PROXY
# is still required and still decides req.ip and therefore rate-limit identity.
# OAuth no longer rides on it.
#
# NOT A SECRET -- this is a public address. Never put a token or key in it.
PUBLIC_BACKEND_ORIGIN=http://localhost:4000


# ---------------------------------------------------------------------------
# Milestone F1.a/F1.b -- Admin Platform kill switch
# ---------------------------------------------------------------------------

# Gates the ENTIRE /admin surface at runtime. Fail-closed: unset, empty,
# or anything other than the exact string "true" (case-insensitive,
# trimmed) makes every /admin route return 404 to every caller,
# including an authenticated administrator. "1", "yes" and "on" are
# deliberately NOT accepted -- a permissive parser here would be a way
# to enable the admin surface by accident.
#
# This is ADDITIONAL deployment protection, never a replacement for
# authorization. With it on, RequireAuthGuard, AdminGuard and
# per-route capability enforcement all still run, unchanged and
# mandatory. Turning it off is the cheapest way to remove the admin
# surface from a deployment without a code revert or a schema change.
#
# Administrator status itself is DATA, never configuration: there is no
# environment variable that grants a role, and none will be added. The
# first SUPER_ADMIN is granted deliberately at database level after
# that account has signed in normally.
ADMIN_PLATFORM_ENABLED=false

# ---------------------------------------------------------------------------
# Pre-MVP Hardening S1 -- runtime bounds and deployment preconditions
# ---------------------------------------------------------------------------

# PostgreSQL connection-pool maximum for the backend process.
#
# Before S1 no pool size was configured anywhere, so pg-pool's own default of
# 10 applied by inheritance. The default below is that same 10, so setting
# nothing changes nothing -- the number is simply a decision now rather than a
# library default nobody had checked.
#
# This pool is shared by EVERYTHING the backend does: news reads, OAuth session
# lookups, telemetry writes, the readiness probe. It is the resource that
# decides whether a flood against one endpoint degrades that feature or takes
# the whole product down, which is why it is worth sizing on purpose.
#
# MORE IS NOT BETTER. Every connection is a real PostgreSQL backend process.
# The ceiling that matters is the database server's own max_connections shared
# across every replica: replicas x DB_POOL_MAX must stay comfortably below it.
# Exceeding it means the database refuses connections outright, which is a far
# worse failure than requests queueing briefly for a pool slot.
#
# An unusable value (non-integer, zero, negative) falls back to the default
# rather than preventing startup: a mistyped pool size is a performance
# problem, and refusing to boot over one would turn it into an outage.
DB_POOL_MAX=10

# Host interface the backend's published port binds to.
#
# S1 changed the Compose default from "every interface" to LOOPBACK. See the
# comment on the backend service's ports: entry in docker-compose.yml for why.
# Change this ONLY with the reachability precondition below in mind.
BACKEND_BIND_HOST=127.0.0.1

# RC-E2 - host interface the FRONTEND's published port binds to.
#
# Completes what S1 started. Before this the frontend published on every
# interface, so http://host:3000 served the whole application in cleartext,
# around the reverse proxy that terminates TLS - and therefore around HSTS and
# around whatever header policy the edge applies. Nothing in this repository
# configures a proxy, so that was not a theoretical bypass.
#
# Set it to 0.0.0.0 only if this container is genuinely meant to face the
# internet directly, which for a production deployment it should not be.
FRONTEND_BIND_HOST=127.0.0.1

# Port the backend process listens on INSIDE its container.
#
# Read by backend/src/main.ts; defaults to 4000 when unset. docker-compose.yml
# sets it explicitly for the backend service, and it is deliberately distinct
# from BACKEND_PORT, which is the HOST port the container publishes to.
PORT=4000

# Request body-size limit: 64kb, set in backend/src/main.ts.
#
# Deliberately NOT an environment variable -- it is a security bound, not a
# tuning knob, and a deployment that needs it raised has a DTO problem rather
# than a configuration problem. Recorded here so the number is discoverable
# from the place people look for deployment behaviour. The largest legitimate
# payload this API accepts is a support ticket at roughly 10,200 characters of
# user text, which is around 20-25kB once written in a multi-byte script.

# ---------------------------------------------------------------------------
# RC-E2 -- news provider presentation and cache tuning
# ---------------------------------------------------------------------------
#
# These three were read by the code but documented nowhere, so an operator
# reading this file could not discover them. None is security-critical; all
# three change behaviour, which is reason enough for them to be here.

# Display name shown for the GNews provider in country-feed provenance.
# Read by CountryNewsService; defaults to "GNews Free" when unset or empty.
# Presentation only -- it never changes which provider is called or what is
# retrieved.
# GNEWS_PROVIDER_DISPLAY_NAME=GNews Free

# Feed tier reported in country-feed provenance. A TWO-VALUE SWITCH, not a
# free string: the exact value "live" reports the live tier, and ANY other
# value -- including unset, and including a typo -- reports "delayed".
#
# It describes the tier a deployment's API plan actually provides. It does not
# purchase or enable anything, so setting "live" on a plan that is not live
# makes the provenance untrue rather than making the feed faster. Leaving it
# unset is the honest default.
# GNEWS_FEED_TIER=live

# Time-to-live, in seconds, for CountryNewsService's in-memory country-feed
# cache. Bounds how stale a country feed may be, and equally how often the
# World Map path reaches a live provider.
#
# Defaults to 300. A non-numeric or negative value falls back to that default
# rather than failing. 0 is accepted and means "do not serve from cache",
# which costs a live provider call on every country request -- deliberate only
# if the provider quota can carry it.
# COUNTRY_NEWS_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# RC-E2 -- COLD-BUILD NETWORK DEPENDENCIES (build time only)
# ---------------------------------------------------------------------------
#
# A production image build reaches FOUR external hosts across THREE providers.
# None of them is contacted at RUNTIME by a deployed application, and none is
# contacted by a visitor's browser -- this list is about BUILD availability and
# reproducibility, nothing else.
#
#   registry.npmjs.org      npm ci, in every stage of both Dockerfiles
#   binaries.prisma.sh      @prisma/engines postinstall, and
#                           `npx prisma generate` in backend/Dockerfile
#   fonts.googleapis.com    next/font/google -- the font CSS
#   fonts.gstatic.com       next/font/google -- the font binaries
#
# WHY THE FONT HOSTS MATTER, precisely. next/font/google downloads the fonts
# at BUILD time and SELF-HOSTS them under .next/static/media/, so the browser
# only ever fetches them from our own origin. A deployed site therefore never
# breaks because Google is unreachable. A DEPLOY does -- including an emergency
# rebuild to roll back, which is the worst possible moment to depend on a
# third party.
#
# DOCKER BUILDS ARE MORE EXPOSED THAN CI. Every `docker build` starts from a
# clean layer with no .next/cache, so the font fetch is always cold.
#
# If your build runner has restricted egress, allow these four hosts. The CI
# workflow runs a preflight that checks all four and fails immediately with a
# clear message rather than partway through a build with a confusing one.
#
# Note that vendoring the fonts would remove two of these four hosts and not
# the other two: npm and Prisma are unavoidable for a cold build.

# ---------------------------------------------------------------------------
# DEPLOYMENT PRECONDITIONS -- READ BEFORE THE FIRST PUBLIC DEPLOY
# ---------------------------------------------------------------------------
#
# These are not settings. They are properties the surrounding infrastructure
# must have for settings elsewhere in this file to mean what they say. Each one
# fails SILENTLY when it is not met -- nothing crashes, nothing logs an error,
# and the symptom appears somewhere unrelated. That is exactly why they are
# written down here rather than left in somebody's memory.
#
# 1. THE EDGE MUST *OVERWRITE* X-Forwarded-For, NOT APPEND TO IT.
#    Every rate limit in this application keys on the client address, and with
#    TRUST_PROXY set that address is read from X-Forwarded-For. A proxy that
#    APPENDS to a client-supplied header lets any caller prepend an address of
#    their choosing and mint a fresh rate-limit identity on every request --
#    the per-IP limits then exist but never fire. A proxy that OVERWRITES the
#    header with the real peer address is what makes them real.
#    nginx: proxy_set_header X-Forwarded-For $remote_addr;   (not $proxy_add_x_forwarded_for)
#
# 2. THE BACKEND MUST NOT BE REACHABLE EXCEPT THROUGH THOSE PROXIES,
#    if TRUST_PROXY is a hop COUNT. A count says "believe the Nth-from-last
#    entry", which is only sound when every request genuinely arrived through
#    that many trusted hops. If the backend can also be reached directly, an
#    attacker simply supplies the chain themselves. BACKEND_BIND_HOST above
#    defaults to loopback for this reason.
#    The IP/CIDR ALLOWLIST form of TRUST_PROXY does NOT carry this precondition
#    -- it names which peers may be believed -- and is the safer choice
#    wherever the proxy addresses are known.
#
# 3. THE FRONTEND AND BACKEND MUST SHARE A REGISTRABLE SITE.
#    Every cookie this backend sets uses SameSite=Lax, which is required so the
#    session survives the top-level redirect back from Google's consent screen
#    -- SameSite=Strict would drop it on exactly that navigation. The cost is
#    that a browser will NOT send a Lax cookie on a cross-SITE fetch/XHR.
#    So app.example.com + api.example.com is fine (one registrable site), and
#    app.example.com + api.example.net is NOT: every authenticated feature
#    would fail in production while working perfectly in development, with no
#    error anywhere. Serving both through ONE origin behind one proxy avoids
#    the question entirely and is the recommended shape.
#
# 4. SECURITY HEADERS FOR THE HTML ORIGIN BELONG AT THE EDGE.
#    helmet() runs in this backend, which serves JSON only. The origin browsers
#    load DOCUMENTS from is the Next.js frontend, and it sets no
#    Content-Security-Policy, frame-ancestors, Strict-Transport-Security or
#    Referrer-Policy of its own. Set them at the reverse proxy that terminates
#    TLS. Without them the application can be framed and full URLs leak as
#    Referer to third-party image hosts.
#
# 5. RATE LIMITS ARE PER PROCESS.
#    The throttler uses in-memory storage, so buckets are not shared between
#    replicas: N replicas multiply every limit by N, including the deliberately
#    strict 5/60s on the paid AI endpoint. Correct at one instance; a conscious
#    precondition before scaling out.

# ---------------------------------------------------------------------------
# SUPPORT AI — the GlobalNews AI Support Agent (SUPPORT-AI-1)
# ---------------------------------------------------------------------------
#
# The agent writes an immediate first response into every new support ticket.
# THAT PART NEEDS NO CONFIGURATION AND NO PROVIDER: it is deterministic text
# chosen by category, it is written inside the same transaction as the ticket,
# and it happens whether or not anything below is set.
#
# These settings govern ONLY the optional follow-up step, in which a NEWS
# QUESTION -- and no other category -- is passed to the EXISTING analysis
# pipeline for an evidence-grounded answer. There is no second AI pipeline and
# no OpenAI client in the support module; see SUPPORT_AI_ENABLED below.

# Fail-closed. The agent attempts an analysis ONLY when this is exactly "true".
# Anything else -- unset, empty, "TRUE", "1", "yes" -- means no provider call
# is made and the ticket receives the honest stored fallback instead. Turning
# this off is the rollback for the whole analysis step and needs no deploy.
SUPPORT_AI_ENABLED=false

# How long a requester waits for the analysis step before the agent gives up
# and stores the fallback. Bounds the WAIT, not the provider call: the
# analysis pipeline takes no abort signal, so a timed-out request keeps
# running and keeps its concurrency slot until it settles.
SUPPORT_AI_TIMEOUT_MS=20000

# The most support-initiated analyses that may be in flight across this
# process at once. Past it the agent stores the fallback rather than queueing:
# a queue turns a burst into a longer burst and hides the cost.
SUPPORT_AI_MAX_CONCURRENT=2

# A per-ACCOUNT allowance for support-initiated analyses, as a limit and a
# window in milliseconds.
#
# THIS IS A SECOND BUDGET, NOT THE ANALYSIS ROUTE'S. POST /analysis/news is
# protected by AnalysisRateLimitGuard, which is an HTTP guard and cannot see a
# direct service call, so a user can spend both. Keep this small for exactly
# that reason. In-process, so two backend instances carry two allowances.
SUPPORT_AI_PER_USER_LIMIT=5
SUPPORT_AI_PER_USER_WINDOW=900000
## Global Reach: explicit worker acquisition only; Production HOLD remains.
GLOBAL_REACH_ACQUISITION_ACTIVE=false
GLOBAL_REACH_SOURCE_ALLOWLIST=
