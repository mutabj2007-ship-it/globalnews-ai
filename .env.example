# ---------------------------------------------------------------------------
# GlobalNews AI - Root Environment Variables (example)
#
# This root file is used by `docker-compose.yml` to configure ports shared
# across services. Each workspace also has its own .env.example:
# - frontend/.env.example  -> copy to frontend/.env.local
# - backend/.env.example   -> copy to backend/.env
#
# Copy this file to `.env` at the project root before running
# `docker compose up`.
# ---------------------------------------------------------------------------

# Ports exposed on the host machine
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ---------------------------------------------------------------------------
# Application environment
# ---------------------------------------------------------------------------

# Use "development" for local development.
# NODE_ENV=production always forces production-safe AI execution behavior.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (Milestone #53)
# ---------------------------------------------------------------------------

# PostgreSQL connection string for backend/src/database/prisma.service.ts.
#
# REQUIRED for the backend to start at all, in every environment
# (development and production alike) — PrismaService's constructor
# throws immediately if this is missing, before any HTTP request is
# ever handled. This is a genuine startup dependency, not an optional
# convenience: NewsService (via ArticlePersistenceService) and the
# health check both depend on it.
#
# A missing DATABASE_URL is the most common reason a fresh checkout
# fails to start — set this before running `npm run dev:backend` or
# `npm run start:backend`.
#
# Never commit a real connection string (username/password included).
# The example below is a placeholder only.
DATABASE_URL=postgresql://globalnews_ai_user:change_me@localhost:5432/globalnews_ai?schema=public

# ---------------------------------------------------------------------------
# Backend security (Milestone #34)
# ---------------------------------------------------------------------------

# The exact origin (scheme + host + port) allowed to make CORS requests
# to the backend.
#
# Development (NODE_ENV != production):
#   May be left unset. The backend falls back to
#   http://localhost:3000 (this repo's default frontend dev server).
#
# Production (NODE_ENV=production):
#   A real, non-blank origin is required, e.g.
#   https://app.globalnews.example
#   A missing, empty, or whitespace-only value causes backend startup
#   to fail closed rather than silently allowing http://localhost:3000
#   in production. No network request is made to verify this value.
#
# CORS is a browser same-origin convenience, not an authentication or
# API security boundary — see rate limiting below for abuse control.
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend runtime configuration (Milestone #60)
# ---------------------------------------------------------------------------

# The frontend's own base URL for the backend API — the counterpart to
# FRONTEND_ORIGIN above (that one tells the backend which frontend origin
# to trust; this one tells the frontend which backend to call).
#
# Development: http://localhost:4000 (this repo's default backend dev
# server — matches BACKEND_PORT above).
#
# Production: must be set to the real, deployed backend URL, e.g.
#   https://api.globalnews.example
#
# IMPORTANT — because this variable name starts with NEXT_PUBLIC_,
# Next.js inlines its value directly into the built frontend JavaScript
# bundle at BUILD TIME, not read at runtime like a typical server-side
# environment variable. If it is missing or wrong when the production
# frontend is built, every visitor's browser will silently try to reach
# the wrong backend (or localhost) — there is no way to fix this after
# the build without rebuilding the frontend. Set it correctly before
# running the production frontend build, not just before starting it.
#
# This is a plain base URL, never a secret — do not place any API key,
# token, or credential in this variable.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# News provider
# ---------------------------------------------------------------------------

# GNews API key, passed through to the backend container.
# Leave unset during local development to allow the news module to use
# its configured mock behavior.
# Never commit a real API key.
#
# Milestone #33: NODE_ENV=production always requires a real, non-blank
# GNEWS_API_KEY. A missing, empty, or whitespace-only value causes
# backend startup to fail closed rather than silently serving mock
# news as if it were live reporting.
GNEWS_API_KEY=replace_with_your_gnews_key

# ---------------------------------------------------------------------------
# M64.2 — GDELT GEO 2.0 signal provider
# ---------------------------------------------------------------------------
# GDELT GEO 2.0 is a public API and does not require an API key (confirmed
# during the M64.2 audit). Configuration exists so nothing is hardcoded
# throughout service code, per the same convention GNews already follows.
GDELT_ENABLED=true
GDELT_GEO_API_BASE_URL=https://api.gdeltproject.org/api/v2/geo/geo
GDELT_REQUEST_TIMEOUT_MS=8000
GDELT_DEFAULT_LIMIT=25

# ---------------------------------------------------------------------------
# M64.4 — Event Registry signal provider
# ---------------------------------------------------------------------------
# Unlike GDELT, Event Registry requires a real API key for meaningful use
# (confirmed from the official OpenAPI spec's own securitySchemes block).
# Leave EVENT_REGISTRY_ENABLED=false (or leave the key blank) during local
# development — the provider reports itself honestly disabled/unconfigured
# and makes zero network calls. Never commit a real API key.
EVENT_REGISTRY_ENABLED=false
EVENT_REGISTRY_API_KEY=replace_with_your_event_registry_key
EVENT_REGISTRY_BASE_URL=https://eventregistry.org/api/v1/event/getEvents
EVENT_REGISTRY_REQUEST_TIMEOUT_MS=8000
EVENT_REGISTRY_DEFAULT_LIMIT=25

# ---------------------------------------------------------------------------
# AI analysis provider
# ---------------------------------------------------------------------------

# Explicit AI execution mode.
#
# development:
#   Local development may use mock analysis when no OpenAI key is available.
#
# production:
#   Production AI is expected. A missing or blank OPENAI_API_KEY causes
#   backend startup to fail closed.
#
# IMPORTANT:
# NODE_ENV=production always forces production AI mode even if this value
# is omitted or incorrectly set to "development".
AI_EXECUTION_MODE=development

# OpenAI API key.
# This is passed only to the backend, never to the frontend.
#
# Local development:
#   The key may be omitted when mock analysis is intended.
#
# Production:
#   A valid non-blank key is required or backend startup fails closed.
#
# Never commit a real API key.
OPENAI_API_KEY=replace_with_your_openai_key

# OpenAI model used by the analysis provider.
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Analysis limits and resilience
# ---------------------------------------------------------------------------

# Maximum number of retrieved articles sent to the AI provider.
ANALYSIS_MAX_ARTICLES=8

# Maximum amount of article title/summary content sent per article.
ANALYSIS_MAX_ARTICLE_CHARS=1200

# Timeout for each AI provider attempt, in milliseconds.
ANALYSIS_TIMEOUT_MS=20000

# Successful analysis cache lifetime, in seconds.
# Set to 0 only if caching is intentionally disabled.
ANALYSIS_CACHE_TTL_SECONDS=300

# Number of retry attempts AFTER the initial OpenAI request.
# 0 disables retries.
# Default: 2.
ANALYSIS_RETRY_ATTEMPTS=2

# Base delay, in milliseconds, for exponential retry backoff.
# Default: 300 ms.
ANALYSIS_RETRY_BASE_DELAY_MS=300

# Milestone #45 — hard upper bound on OpenAI completion length, in
# tokens. Sent as max_completion_tokens (not the deprecated max_tokens)
# on every OpenAI request. Bounds worst-case completion cost regardless
# of how verbose a model response might otherwise be.
# Default: 2000.
ANALYSIS_MAX_COMPLETION_TOKENS=2000

# ---------------------------------------------------------------------------
# Milestone #57 -- Optional Accounts (Google OAuth/OIDC)
# ---------------------------------------------------------------------------

# Google OAuth 2.0 / OIDC client credentials, used ONLY by the optional
# sign-in flow (GET /auth/google, GET /auth/google/callback). Accounts
# are entirely optional -- every existing browse/search/map/analysis
# capability works with these values absent. They are required only for
# a real user to complete Sign In successfully.
#
# Register an OAuth 2.0 Client ID (Web application type) in Google Cloud
# Console, with an authorized redirect URI of:
#   http://localhost:4000/auth/google/callback   (development)
#   https://<your-production-backend-host>/auth/google/callback
#
# Never commit real values -- the examples below are placeholders only.
OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=change_me

# Milestone #57 security correction -- HMAC-SHA256 secret used to
# authenticate the ephemeral OAuth flow-state cookie (gna_oauth_flow)
# before its state/codeVerifier/nonce fields are trusted during the
# callback. Deliberately SEPARATE from OAUTH_CLIENT_SECRET -- that
# value is Google's own credential; this one only ever needs to
# authenticate a value this backend generated for itself minutes
# earlier. Never commit a real value -- generate a long random string
# for each environment (e.g. openssl rand -base64 32).
OAUTH_FLOW_SECRET=change_me
