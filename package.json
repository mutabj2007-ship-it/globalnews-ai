{
  "name": "globalnews-ai",
  "version": "0.1.0",
  "private": true,
  "description": "GlobalNews AI - Enterprise monorepo (frontend, backend, shared)",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "predev:backend": "npm run build:shared",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "prebuild:backend": "npm run build:shared",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:shared && npm run build:frontend && npm run build:backend",
    "build:shared": "npm run build --workspace=shared",
    "verify:visual-authority": "node scripts/run-visual-gate.mjs",
    "verify:visual-authority:production": "node scripts/run-visual-gate.mjs --require-all",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "verify:file-inclusion": "node scripts/verify-release-file-inclusion.mjs",
    "test:request-economy": "node scripts/map-request-economy-probe.mjs",
    "test:zoom-controls": "node scripts/map-zoom-controls-probe.mjs",
    "test:shared": "npm run test --workspace=shared",
    "test:eu27-source-packs": "node scripts/verify-eu27-source-packs.mjs && node --test scripts/verify-eu27-source-packs.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "license": "UNLICENSED"
}
