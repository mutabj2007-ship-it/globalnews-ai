# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build outputs ----
dist/
build/
.next/
out/
*.tsbuildinfo

# ---- Environment ----
.env
.env.local
.env.*.local
!.env.example

# ---- Logs ----
logs/
# RELEASE-EXACT-CANDIDATE-FILE-INCLUSION-1 — `logs/` above is a RUNTIME-OUTPUT
# rule, but it also matches this Next.js route segment, which is SOURCE.
# `railway up` honours .gitignore by default, so without this negation the
# admin system-logs page is silently dropped from the deployed artifact and
# the deployed tree is not the reviewed candidate. Verified by
# `node scripts/verify-release-file-inclusion.mjs`.
!frontend/src/app/admin/system/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Testing ----
coverage/
.nyc_output/

# ---- IDE / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- Docker ----
*.pid

# ---- Misc ----
.eslintcache
.turbo/
